# Neon Postgres connection string.
# On production, use the value copied from Neon and keep ?sslmode=require in it.
DATABASE_URL=

# When DATABASE_URL is missing, the app falls back to a local JSON file at data/db.json.

# Trust reverse proxy headers when running behind Vercel or another proxy.
TRUST_PROXY=false

# Compatibility env vars often configured on Vercel for auth stacks.
# The current codebase does not consume them yet, but it is safe to define them there.
SESSION_SECRET=
JWT_SECRET=
COOKIE_SECURE=false

# Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# Gemini Model (optional, defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Server port (optional, defaults to 4000)
PORT=4000

# Admin emails (comma-separated, for admin panel access)
ADMIN_EMAILS=admin@example.com
