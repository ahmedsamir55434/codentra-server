<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'ar' %>" dir="<%= dir || (lang === 'en' ? 'ltr' : 'rtl') %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تأكيد الدفع - Codentra</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="auth-page">
    <div class="container">
      <div class="auth-box" style="max-width: 520px;">
        <h2>تأكيد الدفع</h2>

        <% if (error) { %>
          <div class="error-message"><%= error %></div>
        <% } %>

        <div style="text-align:right; margin-bottom:16px; color:#444;">
          <p style="margin:0 0 8px;">سيتم الخصم من البطاقة: <strong><%= walletCardMasked || '-' %></strong></p>
          <p style="margin:0 0 8px;">صاحب البطاقة: <strong><%= payerName %></strong></p>
          <p style="margin:0 0 8px;">كود التحقق يظهر لصاحب البطاقة داخل قسم <strong>إشعارات البطاقة</strong> في صفحة مشترياته، وقد يصل أيضًا إلى بريده المسجل إذا كانت خدمة الإرسال مفعلة.</p>
          <p style="margin:0;">المبلغ المطلوب: <strong><%= displayMoney(amount) %></strong></p>
        </div>

        <form action="/payment/verify/<%= attempt.id %>" method="POST">
          <div class="form-group">
            <label for="code">كود التحقق</label>
            <input type="text" id="code" name="code" required maxlength="6" placeholder="أدخل الكود المرسل على البريد">
          </div>

          <% if (requiresPassword) { %>
            <div class="form-group">
              <label for="paymentPassword">كلمة مرور البطاقة</label>
              <input type="password" id="paymentPassword" name="paymentPassword" required placeholder="مطلوبة لأن المبلغ كبير ويتجاوز حد التحقق">
            </div>
          <% } %>

          <button type="submit" class="btn btn-primary btn-full">تأكيد الدفع</button>
        </form>

        <p class="auth-link" style="margin-top: 16px;"><a href="/cart">العودة إلى السلة</a></p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
