<%
  const guestPrimaryLinks = [
    { href: '/', label: t('projects') },
    { href: '/community', label: t('community') }
  ];

  const userPrimaryLinks = [
    { href: '/', label: t('projects') },
    { href: '/community', label: t('community') },
    { href: '/my-purchases', label: t('myPurchases') },
    { href: '/notifications', label: t('notifications'), badge: user && user.unreadNotificationsCount ? user.unreadNotificationsCount : 0 },
    { href: '/appointments', label: t('appointments') }
  ];

  const userSecondaryLinks = [
    { href: '/custom-project', label: 'اطلب مشروعك' },
    { href: '/messages', label: 'التواصل' },
    { href: '/cart', label: 'السلة' },
    { href: '/subscriptions', label: 'الاشتراكات' },
    { href: '/loyalty', label: 'نقاطي' },
    { href: '/my-appointments', label: 'مواعيدي' }
  ];

  const adminPrimaryLinks = [
    { href: '/', label: t('projects') },
    { href: '/community', label: t('community') },
    { href: '/admin', label: 'لوحة التحكم' }
  ];

  const adminSecondaryLinks = [];
  if (user && user.role === 'admin') {
    if (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.appointments)) {
      adminPrimaryLinks.push({ href: '/admin/appointments', label: 'المواعيد' });
    }
    adminSecondaryLinks.push({ href: '/admin/team', label: 'الفريق' });
  }

  const primaryLinks = user
    ? (user.role === 'admin' ? adminPrimaryLinks : userPrimaryLinks)
    : guestPrimaryLinks;
  const secondaryLinks = user
    ? (user.role === 'admin' ? adminSecondaryLinks : userSecondaryLinks)
    : [];
  const mobileLinks = [...primaryLinks, ...secondaryLinks].filter((link, index, items) =>
    items.findIndex((candidate) => candidate.href === link.href) === index
  );
%>
<header class="main-header">
  <div class="container nav-shell">
    <div class="logo nav-brand">
      <a href="/">
        <img src="/logo.jpg" alt="Codentra" class="logo-img">
        <span>Codentra</span>
      </a>
    </div>

    <nav class="main-nav smart-nav" aria-label="التنقل الرئيسي">
      <div class="nav-primary" role="list">
        <% primaryLinks.forEach(link => { %>
          <a href="<%= link.href %>" class="nav-pill">
            <span><%= link.label %></span>
            <% if (link.badge) { %>
              <span class="nav-pill-badge"><%= link.badge > 9 ? '9+' : link.badge %></span>
            <% } %>
          </a>
        <% }) %>
      </div>

      <div class="nav-actions">
        <details class="nav-more-menu" id="navOverflowMenu" hidden>
          <summary class="nav-more-trigger" aria-label="روابط إضافية">
            <span><%= t('more') %></span>
            <span class="nav-more-icon">+</span>
          </summary>
          <div class="nav-more-panel" id="navOverflowPanel"></div>
        </details>

        <% if (secondaryLinks.length > 0) { %>
          <details class="nav-more-menu">
            <summary class="nav-more-trigger" aria-label="روابط إضافية">
              <span><%= t('more') %></span>
              <span class="nav-more-icon">+</span>
            </summary>
            <div class="nav-more-panel">
              <% secondaryLinks.forEach(link => { %>
                <a href="<%= link.href %>" class="nav-more-link"><%= link.label %></a>
              <% }) %>
            </div>
          </details>
        <% } %>

        <button type="button" class="btn btn-secondary theme-toggle nav-compact-btn" id="themeToggle" aria-label="تبديل الوضع الليلي/النهاري">
          <%= t('theme') %>
        </button>

        <a href="/lang/<%= lang === 'en' ? 'ar' : 'en' %>" class="btn btn-secondary nav-compact-btn">
          <%= lang === 'en' ? t('languageArabic') : t('languageEnglish') %>
        </a>

        <% if (user) { %>
          <div class="nav-user-chip">
            <span class="nav-user-label"><%= t('hello') %></span>
            <strong><%= user.name %></strong>
          </div>
          <a href="/logout" class="btn btn-secondary nav-compact-btn"><%= t('logout') %></a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary nav-compact-btn"><%= t('login') %></a>
          <a href="/register" class="btn btn-primary nav-compact-btn"><%= t('register') %></a>
        <% } %>

        <button
          type="button"
          class="nav-menu-toggle"
          id="navMenuToggle"
          aria-expanded="false"
          aria-controls="mobileNavPanel"
          aria-label="فتح القائمة">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </nav>
  </div>

  <div class="mobile-nav-panel" id="mobileNavPanel" hidden>
    <div class="mobile-nav-backdrop" data-close-nav></div>
    <div class="mobile-nav-sheet" role="dialog" aria-modal="true" aria-label="قائمة الهاتف">
      <div class="mobile-nav-head">
        <button type="button" class="mobile-nav-close" data-close-nav aria-label="إغلاق القائمة">×</button>
        <a href="/" class="mobile-nav-brand">
          <img src="/logo.jpg" alt="Codentra" class="mobile-nav-brand-logo">
          <span class="mobile-nav-brand-copy">
            <span class="mobile-nav-kicker">Codentra</span>
            <strong>القائمة</strong>
          </span>
        </a>
      </div>

      <div class="mobile-nav-body">
        <nav class="mobile-nav-list" aria-label="روابط الهاتف">
          <% mobileLinks.forEach(link => { %>
            <a href="<%= link.href %>" class="mobile-nav-link">
              <span><%= link.label %></span>
              <% if (link.badge) { %>
                <span class="mobile-nav-badge"><%= link.badge > 9 ? '9+' : link.badge %></span>
              <% } %>
            </a>
          <% }) %>
        </nav>

        <div class="mobile-nav-footer">
          <% if (user) { %>
            <div class="mobile-nav-user">
              <span class="mobile-nav-user-label">الحساب الحالي</span>
              <strong><%= user.name %></strong>
            </div>
          <% } %>

          <button type="button" class="btn btn-secondary mobile-theme-toggle" id="mobileThemeToggle">
            تبديل الوضع
          </button>

          <a href="/lang/<%= lang === 'en' ? 'ar' : 'en' %>" class="btn btn-secondary mobile-action-btn">
            <%= lang === 'en' ? t('languageArabic') : t('languageEnglish') %>
          </a>

          <% if (user) { %>
            <a href="/logout" class="btn btn-secondary mobile-action-btn">خروج</a>
          <% } else { %>
            <div class="mobile-nav-auth">
              <a href="/login" class="btn btn-secondary mobile-action-btn">تسجيل الدخول</a>
              <a href="/register" class="btn btn-primary mobile-action-btn">حساب جديد</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    const primary = document.querySelector('.main-nav .nav-primary');
    const overflowMenu = document.getElementById('navOverflowMenu');
    const overflowPanel = document.getElementById('navOverflowPanel');
    if (!primary || !overflowMenu || !overflowPanel) return;

    const originalItems = Array.from(primary.querySelectorAll('.nav-pill'));

    const rebuild = () => {
      overflowPanel.innerHTML = '';
      overflowMenu.hidden = true;

      originalItems.forEach((item) => {
        if (item.parentElement !== primary) primary.appendChild(item);
      });

      const availableWidth = primary.clientWidth;
      let used = 0;
      const items = Array.from(primary.querySelectorAll('.nav-pill'));

      for (let i = 0; i < items.length; i++) {
        const el = items[i];
        used += el.offsetWidth;
        if (used > availableWidth && items.length > 1) {
          const moved = items.slice(i);
          moved.forEach((linkEl) => {
            const clone = linkEl.cloneNode(true);
            clone.classList.remove('nav-pill');
            clone.classList.add('nav-more-link');
            overflowPanel.appendChild(clone);
            linkEl.remove();
          });
          overflowMenu.hidden = false;
          break;
        }
      }
    };

    window.addEventListener('resize', rebuild);
    window.addEventListener('load', rebuild);
    rebuild();
  })();
</script>
