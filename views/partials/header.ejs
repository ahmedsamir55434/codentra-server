<% 
  const guestPrimaryLinks = [
    { href: '/', label: 'المشاريع' },
    { href: '/ai-advisor', label: 'مستشار AI' }
  ];

  const userPrimaryLinks = [
    { href: '/', label: 'المشاريع' },
    { href: '/custom-project', label: 'اطلب مشروعك', featured: true },
    { href: '/wishlist', label: 'المفضلة' },
    { href: '/my-purchases', label: 'مشترياتي' },
    { href: '/notifications', label: 'الإشعارات', badge: user && user.unreadNotificationsCount ? user.unreadNotificationsCount : 0 }
  ];

  const userSecondaryLinks = [
    { href: '/appointments', label: 'الجلسات' },
    { href: '/custom-project', label: 'اطلب مشروعك' },
    { href: '/ai-advisor', label: 'مستشار AI' },
    { href: '/messages', label: 'التواصل' },
    { href: '/cart', label: 'السلة' },
    { href: '/subscriptions', label: 'الاشتراكات' },
    { href: '/membership', label: 'عضويتي' },
    { href: '/loyalty', label: 'نقاطي' },
    { href: '/my-appointments', label: 'مواعيدي' }
  ];

  const adminPrimaryLinks = [
    { href: '/', label: 'المشاريع' },
    { href: '/admin', label: 'لوحة التحكم' }
  ];

  const adminSecondaryLinks = [];
  if (user && user.role === 'admin') {
    if (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.appointments)) {
      adminPrimaryLinks.push({ href: '/admin/appointments', label: 'المواعيد' });
    }
    adminSecondaryLinks.push({ href: '/admin/team', label: 'الفريق' });
  }

  const primaryLinks = user
    ? (user.role === 'admin' ? adminPrimaryLinks : userPrimaryLinks)
    : guestPrimaryLinks;
  const secondaryLinks = user
    ? (user.role === 'admin' ? adminSecondaryLinks : userSecondaryLinks)
    : [];
  const mobileLinks = [...primaryLinks, ...secondaryLinks].filter((link, index, items) =>
    items.findIndex((candidate) => candidate.href === link.href) === index
  );

  const getSubscriptionLabel = (subscription) => {
    if (!subscription || subscription.status !== 'active') return 'بدون اشتراك';
    const planId = String(subscription.planId || '').toLowerCase();
    if (planId === 'business' || planId === 'premium') return 'اشتراك Business';
    if (planId === 'pro') return 'اشتراك Pro';
    if (planId === 'starter' || planId === 'basic') return 'اشتراك Starter';
    return 'اشتراك نشط';
  };

  const getSubscriptionTierClass = (subscription) => {
    if (!subscription || subscription.status !== 'active') return 'none';
    const planId = String(subscription.planId || '').toLowerCase();
    if (planId === 'business' || planId === 'premium') return 'business';
    if (planId === 'pro') return 'pro';
    if (planId === 'starter' || planId === 'basic') return 'starter';
    return 'active';
  };
%>
<header class="main-header">
  <div class="container nav-shell">
    <div class="logo nav-brand">
      <a href="/">
        <img src="/logo-wordmark.png" alt="Codentra" class="logo-img logo-wordmark-img">
      </a>
    </div>

    <nav class="main-nav smart-nav" aria-label="التنقل الرئيسي">
      <div class="nav-primary" role="list">
        <% primaryLinks.forEach(link => { %>
          <a href="<%= link.href %>" class="nav-pill">
            <span><%= link.label %></span>
            <% if (link.featured) { %><span class="nav-pill-featured">جديد</span><% } %>
            <% if (link.badge) { %>
              <span class="nav-pill-badge"><%= link.badge > 9 ? '9+' : link.badge %></span>
            <% } %>
          </a>
        <% }) %>
      </div>

      <div class="nav-actions">
        <% if (secondaryLinks.length > 0) { %>
          <details class="nav-more-menu">
            <summary class="nav-more-trigger" aria-label="روابط إضافية">
              <span>المزيد</span>
              <span class="nav-more-icon">+</span>
            </summary>
            <div class="nav-more-panel">
              <% secondaryLinks.forEach(link => { %>
                <a href="<%= link.href %>" class="nav-more-link"><%= link.label %></a>
              <% }) %>
            </div>
          </details>
        <% } %>

        <button type="button" class="btn btn-secondary theme-toggle nav-compact-btn" id="themeToggle" aria-label="تبديل الوضع الليلي/النهاري">
          الوضع
        </button>

        <% if (user) { %>
          <div class="nav-user-chip">
            <span class="nav-user-label">مرحباً</span>
            <strong><%= user.name %></strong>
            <span class="nav-user-subscription nav-user-subscription-<%= getSubscriptionTierClass(user.subscription) %>">
              <%= getSubscriptionLabel(user.subscription) %>
            </span>
          </div>
          <a href="/logout" class="btn btn-secondary nav-compact-btn">خروج</a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary nav-compact-btn">دخول</a>
          <a href="/register" class="btn btn-primary nav-compact-btn">حساب جديد</a>
        <% } %>

        <button
          type="button"
          class="nav-menu-toggle"
          id="navMenuToggle"
          aria-expanded="false"
          aria-controls="mobileNavPanel"
          aria-label="فتح القائمة">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </nav>
  </div>

  <div class="mobile-nav-panel" id="mobileNavPanel" hidden>
    <div class="mobile-nav-backdrop" data-close-nav></div>
    <div class="mobile-nav-sheet" role="dialog" aria-modal="true" aria-label="قائمة الهاتف">
      <div class="mobile-nav-head">
        <button type="button" class="mobile-nav-close" data-close-nav aria-label="إغلاق القائمة">×</button>
        <a href="/" class="mobile-nav-brand">
          <img src="/logo-wordmark.png" alt="Codentra" class="mobile-nav-brand-logo logo-wordmark-img">
          <span class="mobile-nav-brand-copy">
            <span class="mobile-nav-kicker">Codentra</span>
            <strong>القائمة</strong>
          </span>
        </a>
      </div>

      <div class="mobile-nav-body">
        <nav class="mobile-nav-list" aria-label="روابط الهاتف">
          <% mobileLinks.forEach(link => { %>
            <a href="<%= link.href %>" class="mobile-nav-link">
              <span><%= link.label %></span>
              <% if (link.badge) { %>
                <span class="mobile-nav-badge"><%= link.badge > 9 ? '9+' : link.badge %></span>
              <% } %>
            </a>
          <% }) %>
        </nav>

        <div class="mobile-nav-footer">
          <% if (user) { %>
            <div class="mobile-nav-user">
              <span class="mobile-nav-user-label">الحساب الحالي</span>
              <strong><%= user.name %></strong>
              <span class="mobile-nav-user-subscription mobile-nav-user-subscription-<%= getSubscriptionTierClass(user.subscription) %>"><%= getSubscriptionLabel(user.subscription) %></span>
            </div>
          <% } %>

          <button type="button" class="btn btn-secondary mobile-theme-toggle" id="mobileThemeToggle">
            تبديل الوضع
          </button>

          <% if (user) { %>
            <a href="/logout" class="btn btn-secondary mobile-action-btn">خروج</a>
          <% } else { %>
            <div class="mobile-nav-auth">
              <a href="/login" class="btn btn-secondary mobile-action-btn">تسجيل الدخول</a>
              <a href="/register" class="btn btn-primary mobile-action-btn">حساب جديد</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</header>

<div class="site-notice" id="siteNotice" role="status" aria-live="polite">
  <div class="site-notice-inner container">
    <span class="site-notice-dot" aria-hidden="true"></span>
    <strong>جديد في Codentra</strong>
    <span>قارن المشاريع، شوف الصور كاملة، واختار نقطة انطلاقك في دقائق.</span>
    <a href="/#market">ابدأ الاستكشاف <span aria-hidden="true">↙</span></a>
    <button type="button" class="site-notice-close" id="siteNoticeClose" aria-label="إغلاق الإشعار">×</button>
  </div>
</div>

<link rel="stylesheet" href="/css/brand-redesign.css">
<link rel="stylesheet" href="/css/brand-phase2.css">
