<footer class="main-footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <img src="/logo-wordmark.png" alt="Codentra" class="footer-logo logo-wordmark-img">
        <p>منصة بيع المشاريع البرمجية</p>
      </div>
      <div class="footer-links">
        <a href="/">الرئيسية</a>
        <a href="<%= user && user.role === 'user' ? '/subscriptions' : '/register' %>">العضوية</a>
        <% if (user && user.role === 'user') { %><a href="/membership">عضويتي</a><% } %>
        <a href="/login">تسجيل الدخول</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 Codentra. جميع الحقوق محفوظة.</p>
    </div>
  </div>
</footer>

<script src="/js/theme.js"></script>
<script src="/js/site-nav.js"></script>
<script src="/js/wishlist.js"></script>
<script src="/js/image-upload.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/market-filters.js"></script>

<%
  // Auth-sensitive pages must not be prerendered or prefetched: a page
  // prepared before login can otherwise be reused after the session changes.
  const speculationPrerenderUrls = [];
  const speculationPrefetchUrls = ['/ai-advisor'];
%>
<script type="speculationrules">
{
  "prerender": [
    { "source": "list", "urls": <%- JSON.stringify(speculationPrerenderUrls) %> }
  ],
  "prefetch": [
    { "source": "list", "urls": <%- JSON.stringify(speculationPrefetchUrls) %> }
  ]
}
</script>
