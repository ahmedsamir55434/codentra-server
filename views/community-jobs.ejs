<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jobs - Community</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header', { user: user }) %>

  <main class="container" style="padding: 30px 0;">
    <h1 style="margin-bottom: 10px;">وظائف الكومينتي</h1>

    <% if (error) { %>
      <div style="background:#ffe5e5;color:#a30000;padding:10px;border-radius:8px;margin:10px 0;"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div style="background:#e7ffe5;color:#116400;padding:10px;border-radius:8px;margin:10px 0;"><%= success %></div>
    <% } %>

    <% if (!jobs || jobs.length === 0) { %>
      <div class="empty-state"><p>لا توجد وظائف حالياً</p></div>
    <% } else { %>
      <div class="projects-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
        <% jobs.forEach(job => { %>
          <div class="project-card">
            <div class="project-content">
              <h3 class="project-title"><%= job.title %></h3>
              <p class="project-description"><%= job.description %></p>
              <p style="margin: 8px 0;"><strong>الأجر:</strong> <%= job.salary %></p>
              <p style="margin: 8px 0;"><strong>الخبرة:</strong> <%= job.experienceYears %> سنة</p>
              <a class="btn btn-primary" href="/community/jobs/<%= job.id %>">التفاصيل والتقديم</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div style="margin-top: 20px;">
      <a href="/community">رجوع للكومينتي</a>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/theme.js"></script>
</body>
</html>
