<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= job.title %> - Job</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header', { user: user }) %>

  <main class="container" style="padding: 30px 0;">
    <h1 style="margin-bottom: 10px;"><%= job.title %></h1>

    <% if (error) { %>
      <div style="background:#ffe5e5;color:#a30000;padding:10px;border-radius:8px;margin:10px 0;"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div style="background:#e7ffe5;color:#116400;padding:10px;border-radius:8px;margin:10px 0;"><%= success %></div>
    <% } %>

    <section style="background: var(--card-bg, #fff); padding: 15px; border-radius: 12px; border: 1px solid rgba(0,0,0,0.08);">
      <p style="white-space:pre-wrap;"><%= job.description %></p>
      <p style="margin: 10px 0;"><strong>الأجر:</strong> <%= job.salary %></p>
      <p style="margin: 10px 0;"><strong>سنين الخبرة:</strong> <%= job.experienceYears %></p>
    </section>

    <section style="margin-top: 20px;">
      <h2 style="margin-bottom: 10px;">التقديم على الوظيفة</h2>

      <% if (!user) { %>
        <a href="/login" class="btn btn-primary">سجل دخول للتقديم</a>
      <% } else { %>
        <form action="/community/jobs/<%= job.id %>/apply" method="POST" enctype="multipart/form-data" style="background: var(--card-bg, #fff); padding: 15px; border-radius: 12px; border: 1px solid rgba(0,0,0,0.08);">
          <div class="form-group">
            <label>الاسم</label>
            <input type="text" name="name" required style="width:100%;padding:10px;border-radius:10px;border:1px solid rgba(0,0,0,0.2);" />
          </div>
          <div class="form-group">
            <label>العمر</label>
            <input type="number" name="age" required min="1" style="width:100%;padding:10px;border-radius:10px;border:1px solid rgba(0,0,0,0.2);" />
          </div>
          <div class="form-group">
            <label>نبذة عنك</label>
            <textarea name="about" rows="4" required style="width:100%;padding:10px;border-radius:10px;border:1px solid rgba(0,0,0,0.2);"></textarea>
          </div>
          <div class="form-group">
            <label>CV (ملف)</label>
            <input type="file" name="cv" required />
          </div>
          <button type="submit" class="btn btn-primary">إرسال</button>
        </form>
      <% } %>
    </section>

    <div style="margin-top: 20px;">
      <a href="/community/jobs">رجوع للوظائف</a>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/theme.js"></script>
</body>
</html>
