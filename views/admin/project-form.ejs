<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= project ? 'تعديل' : 'إضافة' %> مشروع - Codentra</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/project-images.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="admin-layout">
    <aside class="admin-sidebar">
      <nav class="admin-nav">
        <a href="/admin">الرئيسية</a>
        <a href="/admin/projects/new" class="active">إضافة مشروع</a>
        <a href="/admin/purchases">المشتريات</a>
        <a href="/admin/modifications">طلبات التعديل</a>
        <a href="/admin/messages">الرسائل</a>
        <a href="/admin/reviews">التقييمات</a>
        <a href="/admin/coupons">الكوبونات</a>
        <a href="/admin/referrals">الإحالات</a>
        <a href="/admin/wallet-codes">أكواد الشحن</a>
        <a href="/admin/wallet-balances">أرصدة العملاء</a>
        <% if (user && user.isSuperAdmin) { %>
          <a href="/admin/admins">إدارة الأدمنز</a>
        <% } %>
        <a href="/admin/users">المستخدمين</a>
        <a href="/">العودة للموقع</a>
      </nav>
    </aside>

    <main class="admin-content">
      <h1><%= project ? 'تعديل' : 'إضافة' %> مشروع</h1>
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message" style="background: #fee; border: 1px solid #fcc; color: #c33; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
          <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="glass-card" style="padding: 12px; border-radius: 16px; margin-bottom: 16px; border: 1px solid rgba(80,220,140,0.35); background: rgba(80,220,140,0.08);">
          <%= success %>
        </div>
      <% } %>
      
      <div class="form-container">
        <form action="<%= project ? '/admin/projects/' + project.id : '/admin/projects' %>" method="POST" enctype="multipart/form-data" class="admin-form">
          <input type="hidden" name="priceGuardConfirm" id="priceGuardConfirm" value="0">
          <div class="form-group">
            <label for="title">عنوان المشروع *</label>
            <input type="text" id="title" name="title" value="<%= project ? project.title : '' %>" required>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label for="category">التصنيف *</label>
              <select id="category" name="category" required>
                <option value="">اختر التصنيف</option>
                <option value="Web" <%= project && project.category === 'Web' ? 'selected' : '' %>>ويب</option>
                <option value="Mobile" <%= project && project.category === 'Mobile' ? 'selected' : '' %>>موبايل</option>
                <option value="Desktop" <%= project && project.category === 'Desktop' ? 'selected' : '' %>>ديسكتوب</option>
                <option value="API" <%= project && project.category === 'API' ? 'selected' : '' %>>API</option>
                <option value="Other" <%= project && project.category === 'Other' ? 'selected' : '' %>>أخرى</option>
              </select>
            </div>
            
            <div class="form-group">
              <label for="price">السعر (دولار) *</label>
              <input type="number" id="price" name="price" min="0" step="0.01" value="<%= project ? (Math.round(Number(convertEgpToUsd(project.price || 0)) * 100) / 100) : '' %>" required>
              <small class="form-help">الإدخال بالدولار، والحفظ الداخلي بالجنيه المصري.</small>
            </div>
          </div>

          <div class="form-group">
            <label for="visibility">رؤية المشروع *</label>
            <select id="visibility" name="visibility" required>
              <option value="public" <%= !project || !project.visibility || project.visibility === 'public' ? 'selected' : '' %>>عام</option>
              <option value="subscribers" <%= project && project.visibility === 'subscribers' ? 'selected' : '' %>>لجميع المشتركين</option>
              <option value="starter" <%= project && project.visibility === 'starter' ? 'selected' : '' %>>Starter فما فوق</option>
              <option value="pro" <%= project && project.visibility === 'pro' ? 'selected' : '' %>>Pro فما فوق</option>
              <option value="business" <%= project && project.visibility === 'business' ? 'selected' : '' %>>Business فقط</option>
            </select>
            <small class="form-help">اختر "لجميع المشتركين" لو المنتج متاح لأي اشتراك نشط، أو اختر مستوى أعلى لو عايزه حصريًا.</small>
          </div>
          
          <div class="form-group">
            <label for="technologies">التقنيات المستخدمة (مفصولة بفواصل)</label>
            <input type="text" id="technologies" name="technologies" value="<%= project ? project.technologies.join(', ') : '' %>" placeholder="Node.js, React, MongoDB">
          </div>

          <div class="admin-section" style="margin: 18px 0; padding: 18px; border: 1px solid rgba(255,255,255,.08); border-radius: 18px;">
            <h3 style="margin-top:0;">خصم مؤقت على المنتج</h3>
            <div class="form-row">
              <div class="form-group">
                <label><input type="checkbox" name="saleActive" value="1" <%= project && project.saleActive ? 'checked' : '' %>> تفعيل خصم على هذا المنتج</label>
              </div>
              <div class="form-group">
                <label for="saleType">نوع الخصم</label>
                <select id="saleType" name="saleType">
                  <option value="">بدون</option>
                  <option value="percent" <%= project && project.saleType === 'percent' ? 'selected' : '' %>>نسبة %</option>
                  <option value="fixed" <%= project && project.saleType === 'fixed' ? 'selected' : '' %>>قيمة ثابتة</option>
                </select>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="saleValue">قيمة الخصم</label>
                <input type="number" id="saleValue" name="saleValue" min="0" step="0.01" value="<%= project && project.saleValue ? project.saleValue : '' %>" placeholder="نسبة % أو قيمة بالدولار">
                <small class="form-help">لو اخترت نسبة: أدخل الرقم (مثال: 20 لـ 20%). لو اخترت قيمة ثابتة: أدخل بالدولار (مثال: 10 لـ 10$)</small>
              </div>
              <div class="form-group">
                <label for="saleOccasion">مناسبة الخصم (اختياري)</label>
                <input type="text" id="saleOccasion" name="saleOccasion" value="<%= project && project.saleOccasion ? project.saleOccasion : '' %>" placeholder="مثال: عرض العيد">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="saleDurationDays">مدة الخصم بالأيام (اختياري)</label>
                <input type="number" id="saleDurationDays" name="saleDurationDays" min="1" step="1" value="<%= project && project.saleDurationDays ? project.saleDurationDays : '' %>" placeholder="مثال: 7">
              </div>
              <div class="form-group">
                <label for="saleExpiresAt">أو تاريخ انتهاء ثابت (اختياري)</label>
                <input type="date" id="saleExpiresAt" name="saleExpiresAt" value="<%= project && project.saleExpiresAt ? new Date(project.saleExpiresAt).toISOString().slice(0,10) : '' %>">
                <small class="form-help">لو تركته فارغًا سيظل الخصم دائمًا ما لم تحدد مدة.</small>
              </div>
            </div>
          </div>

          <div class="admin-section" style="margin: 18px 0; padding: 18px; border: 1px solid rgba(255,255,255,.08); border-radius: 18px;">
            <h3 style="margin-top:0;">قفل تنزيلات المشروع (Kill Switch)</h3>
            <div class="form-row">
              <div class="form-group">
                <label>
                  <input type="checkbox" name="downloadsLocked" value="1" <%= project && project.downloadsLocked ? 'checked' : '' %>>
                  قفل تنزيلات هذا المشروع لكل المشترين
                </label>
                <small class="form-help">يقفل كل روابط التحميل الحالية والجديدة لهذا المشروع.</small>
              </div>
              <div class="form-group">
                <label for="downloadsLockReason">سبب القفل (اختياري)</label>
                <input type="text" id="downloadsLockReason" name="downloadsLockReason" value="<%= project && project.downloadsLockReason ? project.downloadsLockReason : '' %>" placeholder="مثال: توقف مؤقت بسبب تسريب">
              </div>
            </div>
          </div>
          
          <div class="form-group">
            <label for="description">وصف المشروع *</label>
            <textarea id="description" name="description" rows="6" required><%= project ? project.description : '' %></textarea>
          </div>

          <% if (project) { %>
            <div class="admin-section" style="margin: 18px 0; padding: 18px; border: 1px solid rgba(255,255,255,.08); border-radius: 18px;">
              <div style="display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
                <h3 style="margin:0;">AI تلخيص المنتج</h3>
                <!-- Avoid nested <form> tags: use formaction/formmethod on a button inside the main form. -->
                <button
                  type="submit"
                  class="btn btn-sm btn-primary"
                  formaction="/admin/projects/<%= project.id %>/ai-summary"
                  formmethod="POST"
                  formnovalidate
                >✨ توليد ملخص AI</button>
              </div>

              <% if (project.aiSummary && (project.aiSummary.short || project.aiSummary.long)) { %>
                <div style="margin-top:10px; opacity:0.8; font-size:13px;">
                  آخر تحديث: <%= project.aiSummary.updatedAt ? new Date(project.aiSummary.updatedAt).toLocaleString('ar') : '-' %>
                  <% if (project.aiSummary.model) { %> | model: <%= project.aiSummary.model %> <% } %>
                </div>
                <div style="margin-top:12px;">
                  <div style="font-weight:800; margin-bottom:6px;">ملخص قصير</div>
                  <div style="opacity:0.9; line-height:1.8;"><%= project.aiSummary.short %></div>
                </div>
                <div style="margin-top:12px;">
                  <div style="font-weight:800; margin-bottom:6px;">ملخص تفصيلي</div>
                  <div style="opacity:0.9; line-height:1.8;"><%= project.aiSummary.long %></div>
                </div>
                <div style="margin-top:12px; display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:12px;">
                  <div>
                    <div style="font-weight:800; margin-bottom:6px;">نقاط قوة</div>
                    <ul style="margin:0; padding:0 18px; opacity:0.9; line-height:1.8;">
                      <% (project.aiSummary.strengths || []).forEach(s => { %>
                        <li><%= s %></li>
                      <% }) %>
                    </ul>
                  </div>
                  <div>
                    <div style="font-weight:800; margin-bottom:6px;">نقاط ضعف</div>
                    <ul style="margin:0; padding:0 18px; opacity:0.9; line-height:1.8;">
                      <% (project.aiSummary.weaknesses || []).forEach(s => { %>
                        <li><%= s %></li>
                      <% }) %>
                    </ul>
                  </div>
                </div>
              <% } else { %>
                <div style="margin-top:10px; opacity:0.8;">لم يتم توليد ملخص AI بعد.</div>
              <% } %>
            </div>
          <% } %>
          
          <div class="form-group">
            <label for="projectFile">ملف المشروع (ZIP) <%= project ? '- اتركه فارغًا للإبقاء على الملف الحالي' : '*' %></label>
            <input type="file" id="projectFile" name="projectFile" accept=".zip" <%= project ? '' : 'required' %>>
            <% if (project && project.filePath) { %>
              <p class="file-info">الملف الحالي: <%= project.filePath %></p>
            <% } %>
          </div>
          
          <div class="form-group">
            <label for="projectImages">صور المشروع (يمكنك اختيار صور متعددة)</label>
            <input type="file" id="projectImages" name="projectImages" accept="image/*" multiple>
            <div class="image-preview-container" id="imagePreviewContainer">
              <% if (project && project.images && project.images.length > 0) { %>
                <% project.images.forEach((image, index) => { %>
                  <div class="image-preview-item">
                    <img src="/<%= image %>" alt="صورة <%= index + 1 %>" class="preview-image">
                    <button type="button" class="remove-image-btn" onclick="removeExistingImage('<%= image %>', this)">×</button>
                  </div>
                <% }); %>
              <% } %>
            </div>
            <small class="form-help">يمكنك رفع حتى 5 صور. الصور المسموح بها: JPG, PNG, GIF, WebP</small>
          </div>
          
          <div class="form-actions">
            <a href="/admin" class="btn btn-secondary">إلغاء</a>
            <button type="submit" class="btn btn-primary"><%= project ? 'حفظ التعديلات' : 'إضافة المشروع' %></button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <script>
    // Image preview and management
    const imageInput = document.getElementById('projectImages');
    const previewContainer = document.getElementById('imagePreviewContainer');
    const maxImages = 5;
    
    // Preview new images
    imageInput.addEventListener('change', function(e) {
      const files = Array.from(e.target.files);
      const existingPreviews = previewContainer.querySelectorAll('.image-preview-item').length;
      
      if (existingPreviews + files.length > maxImages) {
        alert(`يمكنك إضافة حتى ${maxImages} صور فقط. لديك ${existingPreviews} صور بالفعل.`);
        e.target.value = '';
        return;
      }
      
      files.forEach(file => {
        if (file.type.startsWith('image/')) {
          const reader = new FileReader();
          reader.onload = function(e) {
            const previewItem = document.createElement('div');
            previewItem.className = 'image-preview-item';
            previewItem.innerHTML = `
              <img src="${e.target.result}" alt="${file.name}" class="preview-image">
              <button type="button" class="remove-image-btn" onclick="removeImagePreview(this)">×</button>
            `;
            previewContainer.appendChild(previewItem);
          };
          reader.readAsDataURL(file);
        }
      });
    });
    
    // Remove new image preview
    function removeImagePreview(button) {
      button.parentElement.remove();
    }
    
    // Remove existing image
    function removeExistingImage(imagePath, button) {
      if (confirm('هل أنت متأكد من حذف هذه الصورة؟')) {
        // Add to hidden input to mark for deletion
        const hiddenInput = document.createElement('input');
        hiddenInput.type = 'hidden';
        hiddenInput.name = 'removeImages';
        hiddenInput.value = imagePath;
        button.parentElement.appendChild(hiddenInput);
        button.parentElement.remove();
      }
    }

    // Price Guard (double confirmation for risky pricing)
    (function() {
      const form = document.querySelector('form.admin-form');
      if (!form) return;
      const priceInput = document.getElementById('price');
      const saleActiveInput = form.querySelector('input[name="saleActive"]');
      const saleTypeInput = document.getElementById('saleType');
      const saleValueInput = document.getElementById('saleValue');
      const confirmInput = document.getElementById('priceGuardConfirm');

      const toNum = (el) => {
        const n = Number(el && el.value != null ? el.value : NaN);
        return Number.isFinite(n) ? n : NaN;
      };

      form.addEventListener('submit', function(ev) {
        if (!confirmInput) return;
        if (String(confirmInput.value) === '1') return;

        const price = toNum(priceInput);
        const saleActive = !!(saleActiveInput && saleActiveInput.checked);
        const saleType = saleTypeInput ? String(saleTypeInput.value || '') : '';
        const saleValue = toNum(saleValueInput);

        const reasons = [];
        if (!Number.isFinite(price) || price <= 0) reasons.push('السعر 0 أو غير صحيح');
        if (saleActive && saleType === 'percent' && Number.isFinite(saleValue) && saleValue > 90) reasons.push('خصم نسبة أكبر من 90%');
        if (saleActive && saleType === 'fixed' && Number.isFinite(price) && Number.isFinite(saleValue) && saleValue >= price) reasons.push('خصم ثابت أكبر/يساوي السعر');

        if (!reasons.length) return;
        const ok = window.confirm('Price Guard\\n\\n' + reasons.join('\\n') + '\\n\\nهل تريد المتابعة وحفظ هذا التسعير؟');
        if (!ok) {
          ev.preventDefault();
          return;
        }
        confirmInput.value = '1';
      });
    })();
  </script>
</body>
</html>
