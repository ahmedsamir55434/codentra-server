<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>عروض المنتجات - Codentra</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="admin-layout">
    <aside class="admin-sidebar" id="adminSidebar">
      <nav class="admin-nav">
        <a href="/admin">الرئيسية</a>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.projects))) { %>
          <a href="/admin/projects/new">إضافة مشروع</a>
          <a href="/admin/sales" class="active">عروض المنتجات</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.purchases))) { %>
          <a href="/admin/purchases">المشتريات</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.modifications))) { %>
          <a href="/admin/modifications">طلبات التعديل</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.messages))) { %>
          <a href="/admin/messages">الرسائل</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.reviews))) { %>
          <a href="/admin/reviews">التقييمات</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.coupons))) { %>
          <a href="/admin/coupons">الكوبونات</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.referrals))) { %>
          <a href="/admin/referrals">الإحالات</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.walletCodes))) { %>
          <a href="/admin/wallet-codes">أكواد الشحن</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.walletBalances))) { %>
          <a href="/admin/wallet-balances">أرصدة العملاء</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.appointments))) { %>
          <a href="/admin/appointments">المواعيد</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.subscriptionCoupons))) { %>
          <a href="/admin/subscription-coupons">كوبونات الاشتراك</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.subscriptionPlans))) { %>
          <a href="/admin/subscription-plans">خطط الاشتراك</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.subscriptionReports))) { %>
          <a href="/admin/subscription-reports">تقارير الاشتراك</a>
        <% } %>
        <% if (user && user.isSuperAdmin) { %>
          <a href="/admin/meeting-recordings">تسجيلات الاجتماعات</a>
          <a href="/admin/admins">إدارة الأدمنز</a>
        <% } %>
        <% if (user && (user.isSuperAdmin || (user.adminPermissions && user.adminPermissions.users))) { %>
          <a href="/admin/users">المستخدمين</a>
        <% } %>
        <a href="/">العودة للموقع</a>
      </nav>
    </aside>

    <button class="admin-nav-toggle" id="adminNavToggle">☰</button>

    <main class="admin-content">
      <h1>عروض المنتجات</h1>

      <section class="admin-section">
        <div class="section-header">
          <h2>عروض نشطة</h2>
        </div>

        <% if (!activeSales || activeSales.length === 0) { %>
          <div class="empty-state"><p>لا توجد عروض نشطة</p></div>
        <% } else { %>
          <div class="admin-table-container">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>المشروع</th>
                  <th>السعر قبل</th>
                  <th>السعر بعد</th>
                  <th>الخصم</th>
                  <th>المناسبة/المدة</th>
                  <th>إجراءات</th>
                </tr>
              </thead>
              <tbody>
                <% activeSales.forEach(p => { %>
                  <tr>
                    <td><strong><%= p.title %></strong></td>
                    <td><%= displayMoney(p.originalPrice || p.price) %></td>
                    <td><%= displayMoney(p.finalPrice || p.price) %></td>
                    <td>
                      <% if (p.sale && p.sale.saleType === 'percent') { %>
                        -<%= p.sale.saleValue %>%
                      <% } else if (p.sale) { %>
                        -<%= displayMoney(p.sale.discountAmount) %>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td>
                      <div><%= (p.sale && p.sale.occasion) ? p.sale.occasion : 'بدون مناسبة' %></div>
                      <small style="opacity:.75;">
                        <% if (p.sale && p.sale.expiresAt) { %>
                          ينتهي: <%= new Date(p.sale.expiresAt).toLocaleString('ar-EG') %>
                        <% } else if (p.sale && p.sale.durationLabel) { %>
                          <%= p.sale.durationLabel %>
                        <% } else { %>
                          دائم
                        <% } %>
                      </small>
                    </td>
                    <td class="actions">
                      <a href="/admin/projects/<%= p.id %>/edit" class="btn btn-sm btn-primary">تعديل</a>
                      <form action="/admin/sales/<%= p.id %>/disable" method="POST" class="inline-form" onsubmit="return confirm('إيقاف الخصم على هذا المنتج؟');">
                        <button type="submit" class="btn btn-sm btn-danger">إيقاف</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <section class="admin-section">
        <div class="section-header">
          <h2>عروض منتهية/متوقفة</h2>
        </div>

        <% if (!expiredSales || expiredSales.length === 0) { %>
          <div class="empty-state"><p>لا توجد عروض منتهية</p></div>
        <% } else { %>
          <div class="admin-table-container">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>المشروع</th>
                  <th>آخر حالة خصم</th>
                  <th>مناسبة</th>
                  <th>انتهاء</th>
                  <th>إجراءات</th>
                </tr>
              </thead>
              <tbody>
                <% expiredSales.slice(0, 100).forEach(p => { %>
                  <tr>
                    <td><strong><%= p.title %></strong></td>
                    <td>
                      <% if (p.saleType === 'percent') { %>
                        -<%= p.saleValue %>%
                      <% } else if (p.saleType === 'fixed') { %>
                        -<%= displayMoney(p.saleValue || 0) %>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td><%= p.saleOccasion || 'بدون مناسبة' %></td>
                    <td><%= p.saleExpiresAt ? new Date(p.saleExpiresAt).toLocaleString('ar-EG') : '-' %></td>
                    <td class="actions">
                      <a href="/admin/projects/<%= p.id %>/edit" class="btn btn-sm btn-primary">تعديل</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>

