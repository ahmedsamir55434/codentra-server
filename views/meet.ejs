<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>الاجتماع - Codentra</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/meet.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('partials/header') %>

  <div
    id="meetConfig"
    data-room-id="<%= roomId %>"
    data-user-role="<%= user && user.role ? user.role : '' %>"
    data-user-id="<%= currentUserId || '' %>"
    data-return-url="<%= returnUrl || '/my-appointments' %>"
    data-livekit-enabled="<%= liveKitEnabled ? '1' : '0' %>"></div>

  <main class="meet-page">
    <div class="container">
      <div class="meet-header">
        <h1>جلسة مباشرة</h1>
        <div class="meet-room">غرفة: <span dir="ltr"><%= roomId %></span></div>
      </div>

      <div class="meet-grid">
        <section class="meet-video-card">
          <div class="meet-video-title">الفيديو الخاص بك</div>
          <div class="meet-video-frame">
            <video id="localVideo" autoplay playsinline muted></video>
          </div>
        </section>

        <section class="meet-video-card">
          <div class="meet-video-title">المشاركون</div>
          <div class="meet-remote-grid" id="remoteParticipants">
            <div class="meet-empty-state" id="remoteEmptyState">في انتظار انضمام المشاركين...</div>
          </div>
        </section>
      </div>

      <div class="meet-controls">
        <button type="button" class="btn btn-secondary" id="btnToggleMic">الميك</button>
        <button type="button" class="btn btn-secondary" id="btnToggleCam">الكاميرا</button>
        <button type="button" class="btn btn-secondary" id="btnShareScreen">مشاركة الشاشة</button>
        <button type="button" class="btn btn-danger" id="btnEndMeeting">إنهاء الاجتماع</button>
        <a class="btn btn-primary" href="/my-appointments">رجوع</a>
      </div>

      <div class="meet-status-wrap">
        <div class="meet-status" id="meetStatus">جاري التحضير...</div>
        <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
          <div class="meet-recording-note">سيبدأ تسجيل الجلسة تلقائيًا وسيُرفع إلى صفحة تسجيلات الاجتماعات بعد إنهائها.</div>
        <% } %>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/livekit-client/dist/livekit-client.umd.min.js"></script>
  <script src="/js/meet.js"></script>

  <%- include('partials/footer') %>
</body>
</html>
