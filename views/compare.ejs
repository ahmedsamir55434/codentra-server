<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>مقارنة المشاريع - Codentra</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('partials/header') %>
  <section class="projects-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-kicker">Smart Compare</span>
          <h2>مقارنة المشاريع</h2>
        </div>
      </div>

      <% if (!projects || projects.length < 2) { %>
        <div class="empty-state">
          <p>اختر مشروعين على الأقل للمقارنة.</p>
          <a href="/" class="btn btn-primary">العودة للمشاريع</a>
        </div>
      <% } else { %>
        <div class="compare-grid">
          <% projects.forEach(project => { const rating = ratingsByProjectId.get(project.id) || { avgRating: 0, count: 0 }; %>
            <article class="compare-card">
              <h3><%= project.title %></h3>
              <p class="compare-line"><strong>السعر:</strong> <%= displayMoney(project.finalPrice || project.price) %></p>
              <p class="compare-line"><strong>النوع:</strong> <%= project.category %></p>
              <p class="compare-line"><strong>التقييم:</strong> <%= rating.avgRating ? rating.avgRating.toFixed(1) : '0.0' %> / 5 (<%= rating.count %>)</p>
              <div class="compare-tech-list">
                <% (project.technologies || []).forEach(tech => { %>
                  <span class="tech-tag"><%= tech %></span>
                <% }) %>
              </div>
              <a href="/project/<%= project.id %>" class="btn btn-primary">عرض المشروع</a>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
  <%- include('partials/footer') %>
</body>
</html>
