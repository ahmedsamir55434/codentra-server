<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>المفضلة - Codentra</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('partials/header') %>
  <section class="projects-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-kicker">Wishlist</span>
          <h2>مشاريعي المفضلة</h2>
        </div>
      </div>
      <% if (!projects || projects.length === 0) { %>
        <div class="empty-state"><p>لا توجد مشاريع في المفضلة بعد</p></div>
      <% } else { %>
        <div class="projects-grid">
          <% projects.forEach(project => { %>
            <div class="project-card">
              <div class="project-image <%= project.images && project.images.length > 0 ? 'has-cover' : '' %>">
                <% if (project.images && project.images.length > 0) { %>
                  <img src="/<%= project.images[0] %>" alt="<%= project.title %>" class="project-cover">
                <% } else { %>
                  <div class="placeholder-img"><span><%= project.category %></span></div>
                <% } %>
              </div>
              <div class="project-info">
                <h3><%= project.title %></h3>
                <p class="project-desc"><%= project.description.substring(0, 100) %><%= project.description.length > 100 ? '...' : '' %></p>
                <div class="project-footer">
                  <span class="price"><%= displayMoney(project.finalPrice || project.price) %></span>
                  <a href="/project/<%= project.id %>" class="btn btn-primary">تفاصيل</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
  <%- include('partials/footer') %>
</body>
</html>
