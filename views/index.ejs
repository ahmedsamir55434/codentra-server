<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Codentra - مشاريع برمجية جاهزة</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('partials/header') %>
  <% const safeRecentProjects = Array.isArray(recentProjects) ? recentProjects : []; %>
  <% const getSubscriptionLabel = (subscription) => {
    if (!subscription || subscription.status !== 'active') return null;
    const planId = String(subscription.planId || '').toLowerCase();
    if (planId === 'business' || planId === 'premium') return 'Business';
    if (planId === 'pro') return 'Pro';
    if (planId === 'starter' || planId === 'basic') return 'Starter';
    return 'نشط';
  }; %>

  <section class="release-banner-section" aria-label="Codentra v3 launch">
    <div class="container">
      <div class="release-banner">
        <div class="release-banner-orb release-banner-orb-one" aria-hidden="true"></div>
        <div class="release-banner-orb release-banner-orb-two" aria-hidden="true"></div>
        <div class="release-banner-copy">
          <span class="release-banner-badge">NEW ERA • GLASS UPGRADE</span>
          <h2>Codentra v3</h2>
          <p>التحديث الثالث وصل بهوية أفخم، لمعة زجاجية أعمق، وتجربة أكثر فخامة تخطف العين من أول نظرة.</p>
          <div class="release-banner-highlights">
            <span>واجهة Glass Premium</span>
            <span>حركة وعمق بصري أهدى</span>
            <span>تجربة أنعم في الدارك واللايت</span>
          </div>
        </div>
        <div class="release-banner-mark" aria-hidden="true">
          <div class="release-mark-topline">CODENTRA RELEASE</div>
          <div class="release-mark-core">
            <div class="release-mark-word">CODENTRA</div>
            <div class="release-mark-divider"></div>
            <div class="release-mark-version">v3</div>
          </div>
          <div class="release-mark-shine"></div>
          <span class="release-mark-corner release-mark-corner-top"></span>
          <span class="release-mark-corner release-mark-corner-bottom"></span>
        </div>
      </div>
    </div>
  </section>

  <main class="hero">
    <div class="container">
      <h1>مشاريع برمجية احترافية جاهزة</h1>
      <p>اشترِ مشاريع ويب وتطبيقات كاملة مع الكود المصدر فورًا</p>
      <% if (user && user.role === 'user' && getSubscriptionLabel(user.subscription)) { %>
        <div class="hero-subscription-chip">
          <span class="hero-subscription-kicker">اشتراكك الحالي</span>
          <strong><%= getSubscriptionLabel(user.subscription) %></strong>
          <span>يوفر لك مزايا ووصولًا خاصًا داخل Codentra</span>
        </div>
      <% } %>
    </div>
  </main>

  <% if (safeRecentProjects.length > 0) { %>
    <section class="projects-section recently-viewed-section">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="section-kicker">متابعة سريعة</span>
            <h2>شوهد مؤخرًا</h2>
          </div>
          <p class="section-copy">ارجع بسرعة لآخر المشاريع التي فتحتها وكمل من حيث توقفت.</p>
        </div>

        <div class="projects-grid recent-projects-grid">
          <% safeRecentProjects.forEach(project => { %>
            <div class="project-card project-card-recent">
              <div class="project-image <%= project.images && project.images.length > 0 ? 'has-cover' : '' %>" style="position:relative;">
                <% if (project.images && project.images.length > 0) { %>
                  <img src="/<%= project.images[0] %>" alt="<%= project.title %>" class="project-cover">
                <% } else { %>
                  <div class="placeholder-img">
                    <span><%= project.category %></span>
                  </div>
                <% } %>
              </div>
              <div class="project-info">
                <% const isWishlistedRecent = user && user.role === 'user' && Array.isArray(wishlistProjectIds) && wishlistProjectIds.includes(project.id); %>
                <% if (user && user.role === 'user') { %>
                  <form action="/wishlist/toggle" method="POST" class="wishlist-form">
                    <input type="hidden" name="projectId" value="<%= project.id %>">
                    <button type="submit" class="wishlist-btn <%= isWishlistedRecent ? 'is-active' : '' %>" aria-label="إضافة للمفضلة">
                      <%= isWishlistedRecent ? '♥' : '♡' %>
                    </button>
                  </form>
                <% } %>
                <span class="project-card-eyebrow">آخر زيارة</span>
                <h3><%= project.title %></h3>
                <% if (project.visibility && project.visibility !== 'public') { %>
                  <div style="margin-top:6px;">
                    <span class="trust-badge trust-badge-last">
                      <% if (project.visibility === 'subscribers') { %>للمشتركين فقط<% } else if (project.visibility === 'starter' || project.visibility === 'basic') { %>Starter فما فوق<% } else if (project.visibility === 'pro') { %>Pro فما فوق<% } else if (project.visibility === 'business' || project.visibility === 'premium') { %>Business فقط<% } %>
                    </span>
                  </div>
                <% } %>
                <p class="project-desc"><%= project.description.substring(0, 100) %><%= project.description.length > 100 ? '...' : '' %></p>
                <div class="project-tech">
                  <% project.technologies.slice(0, 3).forEach(tech => { %>
                    <span class="tech-tag"><%= tech %></span>
                  <% }) %>
                </div>
                <div class="project-footer">
                <% if (project.sale && project.sale.active) { %>
                  <span class="price sale-price"><%= displayMoney(project.finalPrice) %></span>
                  <small style="display:block;opacity:.7;text-decoration:line-through;"><%= displayMoney(project.originalPrice) %></small>
                  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:6px;">
                    <span class="sale-badge"><%= project.sale.saleType === 'percent' ? ('-' + project.sale.saleValue + '%') : 'SALE' %></span>
                    <small style="display:block;color:#7df2b8;">
                      <% if (project.sale.saleType === 'percent') { %>
                        خصم <%= project.sale.saleValue %>%
                      <% } else { %>
                        خصم <%= displayMoney(project.sale.discountAmount) %>
                      <% } %>
                      <%= project.sale.occasion ? '• ' + project.sale.occasion : '' %>
                    </small>
                  </div>
                <% } else { %>
                  <span class="price"><%= displayMoney(project.price) %></span>
                <% } %>
                  <a href="/project/<%= project.id %>" class="btn btn-secondary">متابعة</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <section class="projects-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-kicker">السوق</span>
          <h2>المشاريع المتاحة</h2>
        </div>
        <p class="section-copy">تصفح كل المشاريع الجاهزة واختر المشروع الأنسب لاحتياجك الحالي.</p>
      </div>

      <div class="projects-grid">
        <% projects.forEach(project => { %>
          <div class="project-card">
            <div class="project-image <%= project.images && project.images.length > 0 ? 'has-cover' : '' %>" style="position:relative;">
              <% if (project.visibility && project.visibility !== 'public') { %>
                <span class="sale-badge" style="position:absolute; top:12px; right:12px; z-index:2;">
                  <% if (project.visibility === 'subscribers') { %>
                    للمشتركين
                  <% } else if (project.visibility === 'starter' || project.visibility === 'basic') { %>
                    Starter
                  <% } else if (project.visibility === 'pro') { %>
                    Pro
                  <% } else if (project.visibility === 'business' || project.visibility === 'premium') { %>
                    Business
                  <% } %>
                </span>
              <% } %>
              <% if (project.images && project.images.length > 0) { %>
                <img src="/<%= project.images[0] %>" alt="<%= project.title %>" class="project-cover">
              <% } else { %>
                <div class="placeholder-img">
                  <span><%= project.category %></span>
                </div>
              <% } %>
            </div>
            <div class="project-info">
              <% const isWishlisted = user && user.role === 'user' && Array.isArray(wishlistProjectIds) && wishlistProjectIds.includes(project.id); %>
              <% if (user && user.role === 'user') { %>
                <form action="/wishlist/toggle" method="POST" class="wishlist-form">
                  <input type="hidden" name="projectId" value="<%= project.id %>">
                  <button type="submit" class="wishlist-btn <%= isWishlisted ? 'is-active' : '' %>" aria-label="إضافة للمفضلة">
                    <%= isWishlisted ? '♥' : '♡' %>
                  </button>
                </form>
              <% } %>
              <h3><%= project.title %></h3>
              <% if (project.visibility && project.visibility !== 'public') { %>
                <div style="margin-top:6px;">
                  <span class="trust-badge trust-badge-last">
                    <% if (project.visibility === 'subscribers') { %>للمشتركين فقط<% } else if (project.visibility === 'starter' || project.visibility === 'basic') { %>Starter فما فوق<% } else if (project.visibility === 'pro') { %>Pro فما فوق<% } else if (project.visibility === 'business' || project.visibility === 'premium') { %>Business فقط<% } %>
                  </span>
                </div>
              <% } %>
              <% if (project.trustSignals && (project.trustSignals.isTopSeller || project.trustSignals.lastPurchaseText)) { %>
                <div class="trust-signals">
                  <% if (project.trustSignals.isTopSeller) { %>
                    <span class="trust-badge trust-badge-top">الأكثر مبيعًا</span>
                  <% } %>
                  <% if (project.trustSignals.lastPurchaseText) { %>
                    <span class="trust-badge trust-badge-last"><%= project.trustSignals.lastPurchaseText %></span>
                  <% } %>
                </div>
              <% } %>
              <p class="project-desc"><%= project.description.substring(0, 100) %><%= project.description.length > 100 ? '...' : '' %></p>
              <div class="project-tech">
                <% project.technologies.slice(0, 3).forEach(tech => { %>
                  <span class="tech-tag"><%= tech %></span>
                <% }) %>
              </div>
              <div class="project-footer">
                <% if (project.sale && project.sale.active) { %>
                  <span class="price sale-price"><%= displayMoney(project.finalPrice) %></span>
                  <small style="display:block;opacity:.7;text-decoration:line-through;"><%= displayMoney(project.originalPrice) %></small>
                  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:6px;">
                    <span class="sale-badge"><%= project.sale.saleType === 'percent' ? ('-' + project.sale.saleValue + '%') : 'SALE' %></span>
                    <small style="display:block;color:#7df2b8;">
                      <% if (project.sale.saleType === 'percent') { %>
                        خصم <%= project.sale.saleValue %>%
                      <% } else { %>
                        خصم <%= displayMoney(project.sale.discountAmount) %>
                      <% } %>
                      <%= project.sale.occasion ? '• ' + project.sale.occasion : '' %>
                    </small>
                  </div>
                <% } else { %>
                  <span class="price"><%= displayMoney(project.price) %></span>
                <% } %>
                <a href="/project/<%= project.id %>" class="btn btn-primary">تفاصيل</a>
              </div>
              <button type="button" class="btn btn-secondary compare-toggle-btn" data-project-id="<%= project.id %>">أضف للمقارنة</button>
            </div>
          </div>
        <% }) %>
      </div>
      
      <% if (projects.length === 0) { %>
        <div class="empty-state">
          <p>لا توجد مشاريع متاحة حاليًا</p>
        </div>
      <% } %>
    </div>
  </section>

  <%- include('partials/footer') %>
  <button type="button" id="compareFab" class="compare-fab" hidden>⚖️ <span id="compareFabCount">0</span></button>
  <div id="compareTray" class="compare-tray" hidden>
    <div class="compare-tray-copy">
      <strong>المقارنة الذكية</strong>
      <span id="compareTrayCount">0/3</span>
    </div>
    <div class="compare-tray-actions">
      <button type="button" class="btn btn-secondary" id="clearCompareBtn">مسح</button>
      <button type="button" class="btn btn-secondary" id="closeCompareTrayBtn">إغلاق</button>
      <a href="/compare" class="btn btn-primary" id="goCompareBtn">قارن الآن</a>
    </div>
  </div>
  <script>
    (() => {
      const banner = document.querySelector('.release-banner');
      const bannerCopy = banner ? banner.querySelector('.release-banner-copy') : null;
      const bannerMark = banner ? banner.querySelector('.release-banner-mark') : null;
      if (!banner) return;

      let ticking = false;

      const updateBannerScrollFx = () => {
        const scrollY = window.scrollY || window.pageYOffset || 0;
        const progress = Math.max(0, Math.min(1, scrollY / 360));
        const bannerLift = progress * -26;
        const bannerScale = 1 - (progress * 0.045);
        const copyShift = progress * -20;
        const markShift = progress * 26;
        const markTilt = progress * -12;
        const fade = 1 - (progress * 0.18);

        banner.style.transform = `translate3d(0, ${bannerLift}px, 0) scale(${bannerScale})`;
        banner.style.opacity = String(fade);

        if (bannerCopy) {
          bannerCopy.style.transform = `translate3d(${copyShift}px, ${progress * -6}px, 0)`;
        }

        if (bannerMark) {
          bannerMark.style.transform = `translate3d(${markShift}px, ${progress * -4}px, 0) rotateY(${markTilt}deg)`;
        }

        ticking = false;
      };

      const queueUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateBannerScrollFx);
      };

      updateBannerScrollFx();
      window.addEventListener('scroll', queueUpdate, { passive: true });
      window.addEventListener('resize', queueUpdate, { passive: true });
    })();
  </script>
  <script>
    (() => {
      const KEY = 'compare_projects';
      const MAX = 3;
      const tray = document.getElementById('compareTray');
      const fab = document.getElementById('compareFab');
      const fabCount = document.getElementById('compareFabCount');
      const countNode = document.getElementById('compareTrayCount');
      const clearBtn = document.getElementById('clearCompareBtn');
      const closeTrayBtn = document.getElementById('closeCompareTrayBtn');
      const goBtn = document.getElementById('goCompareBtn');
      const toggles = Array.from(document.querySelectorAll('.compare-toggle-btn'));
      if (!tray || !countNode || !goBtn || !fab || !fabCount) return;

      const getIds = () => {
        try {
          const arr = JSON.parse(localStorage.getItem(KEY) || '[]');
          return Array.isArray(arr) ? arr.filter(Boolean).slice(0, MAX) : [];
        } catch (_) { return []; }
      };
      const setIds = (ids) => localStorage.setItem(KEY, JSON.stringify(ids.slice(0, MAX)));

      const render = () => {
        const ids = getIds();
        fab.hidden = false;
        if (ids.length === 0) {
          tray.hidden = true;
          tray.classList.remove('is-open');
        }
        countNode.textContent = `${ids.length}/3`;
        fabCount.textContent = String(ids.length);
        goBtn.href = `/compare?ids=${encodeURIComponent(ids.join(','))}`;
        toggles.forEach((btn) => {
          const id = btn.getAttribute('data-project-id');
          const active = ids.includes(id);
          btn.textContent = active ? 'إزالة من المقارنة' : 'أضف للمقارنة';
          btn.classList.toggle('is-active', active);
        });
      };

      toggles.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-project-id');
          let ids = getIds();
          if (ids.includes(id)) {
            ids = ids.filter((x) => x !== id);
          } else {
            if (ids.length >= MAX) ids.shift();
            ids.push(id);
          }
          setIds(ids);
          render();
        });
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          setIds([]);
          render();
        });
      }
      if (closeTrayBtn) {
        closeTrayBtn.addEventListener('click', () => {
          tray.hidden = true;
          tray.classList.remove('is-open');
        });
      }
      fab.addEventListener('click', () => {
        const willOpen = tray.hidden;
        tray.hidden = !willOpen;
        tray.classList.toggle('is-open', willOpen);
      });

      tray.hidden = true;
      tray.classList.remove('is-open');
      render();
    })();
  </script>
</body>
</html>
