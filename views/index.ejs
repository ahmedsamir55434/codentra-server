<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Codentra - مشاريع برمجية جاهزة</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('partials/header') %>
  <% const safeRecentProjects = Array.isArray(recentProjects) ? recentProjects : []; %>
  <%
    const homeSubscriptionPlans = Array.isArray(subscriptionPlans) ? subscriptionPlans : [];
    const homeBusinessPlan = homeSubscriptionPlans.find((plan) => String(plan.id || '').toLowerCase() === 'business');
    const homeMaxDiscount = homeBusinessPlan ? 30 : 20;
    const homeSubscriptionHref = user && user.role === 'user' ? '/subscriptions' : '/register';
    const homeSubscriptionCta = user && user.role === 'user' ? 'شوف خطتك' : 'ابدأ عضويتك';
    const homeActivePlan = activeSubscription ? homeSubscriptionPlans.find((plan) => plan.id === activeSubscription.planId) : null;
  %>
  <% const getSubscriptionLabel = (subscription) => {
    if (!subscription || subscription.status !== 'active') return null;
    const planId = String(subscription.planId || '').toLowerCase();
    if (planId === 'business' || planId === 'premium') return 'Business';
    if (planId === 'pro') return 'Pro';
    if (planId === 'starter' || planId === 'basic') return 'Starter';
    return 'نشط';
  }; %>

  <section class="release-banner-section home-hero-section" aria-label="بداية Codentra">
    <div class="container">
      <div class="release-banner">
        <div class="release-banner-orb release-banner-orb-one" aria-hidden="true"></div>
        <div class="release-banner-orb release-banner-orb-two" aria-hidden="true"></div>
        <div class="release-banner-copy attention-copy">
          <span class="release-banner-badge">من الفكرة لحد الإطلاق</span>
          <h2>ابدأ مشروعك<br><span>بشكل أسرع وأذكى.</span></h2>
          <p>قوالب جاهزة، طلبات مخصصة، واشتراكات تساعدك تحول فكرتك لمنتج حقيقي من غير ما تبدأ من الصفر.</p>
          <div class="attention-actions">
            <a class="btn btn-primary" href="#market">استكشف القوالب <span>↙</span></a>
            <a class="btn btn-secondary" href="/custom-project">اطلب مشروعك</a>
          </div>
          <div class="attention-proof">
            <span><b>01</b> قوالب جاهزة</span>
            <span><b>02</b> طلب مخصص</span>
            <span><b>03</b> اشتراكات ذكية</span>
          </div>
        </div>
        <div class="release-banner-mark attention-visual" aria-hidden="true">
          <div class="attention-visual-grid"></div>
          <div class="attention-logo-orbit attention-logo-orbit-one"></div>
          <div class="attention-logo-orbit attention-logo-orbit-two"></div>
          <div class="attention-visual-kicker"><i></i> معاينة حية من Codentra</div>
          <div class="home-hero-product">
            <div class="home-hero-product-head">
              <span>قالب مختار لك</span>
              <b><i></i> LIVE</b>
            </div>
            <div class="home-hero-product-screen">
              <div class="home-hero-ui-topbar">
                <span class="home-hero-ui-dots"><i></i><i></i><i></i></span>
                <strong>codentra / studio</strong>
                <b>منصة جاهزة</b>
              </div>
              <div class="home-hero-ui-body">
                <div class="home-hero-ui-main">
                  <span class="home-hero-ui-label">لوحة مشروعك</span>
                  <strong>من الفكرة<br><em>لمنتج يُباع.</em></strong>
                  <p>واجهة واضحة، خطوات أقل، وإطلاق أسرع.</p>
                  <span class="home-hero-ui-action">ابدأ الآن <b>↙</b></span>
                </div>
                <div class="home-hero-ui-score">
                  <span>جاهزية الإطلاق</span>
                  <strong>100<small>%</small></strong>
                  <div class="home-hero-ui-progress"><i></i></div>
                  <em>جاهز للتعديل</em>
                </div>
              </div>
              <div class="home-hero-ui-metrics">
                <div><b>01</b><span>فكرة واضحة</span></div>
                <div><b>02</b><span>كود مرتب</span></div>
                <div><b>03</b><span>إطلاق فوري</span></div>
              </div>
              <div class="home-hero-ui-sticker">شغل جاهز <b>✦</b></div>
              <div class="home-hero-product-shine"></div>
            </div>
            <div class="home-hero-product-foot">
              <strong>واجهة جاهزة للانطلاق</strong>
              <span>جاهز للتعديل <b>↙</b></span>
            </div>
          </div>
          <div class="home-hero-logo-badge" aria-hidden="true"><span>C</span></div>
          <div class="attention-floating attention-floating-top">جاهز للإطلاق</div>
          <div class="attention-floating attention-floating-bottom">على مقاس فكرتك</div>
          <div class="attention-cross attention-cross-one">+</div>
          <div class="attention-cross attention-cross-two">+</div>
        </div>
      </div>
    </div>
  </section>

  <main class="hero brand-hero">
    <div class="container brand-hero-grid">
      <div class="brand-hero-copy">
        <span class="hero-eyebrow"><i></i> سوق الأفكار الجاهزة</span>
        <h1>فكرتك الجاية<br><span>تبدأ من هنا.</span></h1>
        <p>مشاريع ويب وتطبيقات كاملة، معمولة بعناية عشان تختصر وقتك من أول سطر كود لحد الإطلاق.</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-large" href="#market">استكشف المشاريع <span>↙</span></a>
          <a class="btn btn-secondary btn-large" href="/ai-advisor">اسأل مستشار AI</a>
        </div>
        <div class="hero-proof-row" aria-label="إحصائيات Codentra">
          <div><strong>+120</strong><span>مشروع جاهز</span></div>
          <div><strong>4.9/5</strong><span>رضا العملاء</span></div>
          <div><strong>فوري</strong><span>تسليم الكود</span></div>
        </div>
        <% if (user && user.role === 'user' && getSubscriptionLabel(user.subscription)) { %>
          <div class="hero-subscription-chip">
            <span class="hero-subscription-kicker">اشتراكك الحالي</span>
            <strong><%= getSubscriptionLabel(user.subscription) %></strong>
            <span>مزايا ووصول خاص داخل Codentra</span>
          </div>
        <% } %>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hero-visual-grid"></div>
        <div class="hero-orbit hero-orbit-one"></div>
        <div class="hero-orbit hero-orbit-two"></div>
        <div class="hero-code-card">
          <div class="hero-code-head"><span></span><span></span><span></span><b>codentra / إطلاق</b></div>
          <div class="hero-code-lines"><i></i><i></i><i></i><i></i><i></i><i></i></div>
          <div class="hero-code-foot"><span>جاهز للإطلاق</span><strong>100%</strong></div>
        </div>
        <div class="hero-floating-tag hero-floating-tag-top">تصميم ← تنفيذ</div>
        <div class="hero-floating-tag hero-floating-tag-bottom">نظام زجاجي</div>
        <div class="hero-cross hero-cross-one">+</div>
        <div class="hero-cross hero-cross-two">+</div>
      </div>
    </div>
  </main>

  <section class="offerings-section" aria-label="طرق بدء مشروعك">
    <div class="container">
      <div class="offerings-heading">
        <div>
          <span class="section-kicker">اختار طريقك</span>
          <h2>جاهز تبدأ؟<br><span>إحنا مجهزين لك الطريق.</span></h2>
        </div>
        <p>سواء عايز تنطلق بسرعة أو تبني حاجة على مقاسك، عندك نقطة بداية واضحة.</p>
      </div>
      <div class="offerings-grid">
        <a class="offering-card offering-template" href="#market">
          <div class="offering-card-top"><span class="offering-index">01</span><span class="offering-arrow">↙</span></div>
          <div class="offering-card-copy"><span class="offering-label">جاهز للإطلاق</span><h3>التيمبلتس</h3><p>اختار مشروع كامل، حمّل الكود، وابدأ التعديل من أول يوم.</p></div>
          <span class="offering-link">تصفح المشاريع <b>↙</b></span>
        </a>
        <a class="offering-card offering-custom" href="/custom-project">
          <div class="offering-card-top"><span class="offering-index">02</span><span class="offering-arrow">↙</span></div>
          <div class="offering-card-copy"><span class="offering-label">على مقاس فكرتك</span><h3>اطلب مشروعك</h3><p>ابعت فكرتك، والـ Codentra team يحولها لخطة واضحة ومنتج قابل للتنفيذ.</p></div>
          <div class="offering-steps"><span>فكرة</span><i>→</i><span>خطة</span><i>→</i><span>منتج</span></div>
          <span class="offering-link">ابدأ طلبك <b>↙</b></span>
        </a>
      </div>
    </div>
  </section>

  <section class="subscription-spotlight-section" aria-labelledby="subscriptionSpotlightTitle">
    <div class="container">
      <div class="subscription-spotlight">
        <div class="subscription-spotlight-copy">
          <div class="subscription-spotlight-kicker">
            <span class="subscription-spotlight-dot" aria-hidden="true"></span>
            <span>عضوية Codentra</span>
            <strong>خصم يصل إلى <%= homeMaxDiscount %>%</strong>
          </div>
          <h1 id="subscriptionSpotlightTitle">كل مشروع تبدأه<br><span>قيمته تزيد مع عضويتك.</span></h1>
          <p>خصومات ثابتة، وصول مبكر للمشاريع، ودعم أسرع — اختار المستوى اللي يناسب طريقة شغلك وخلي كل شراء أذكى من اللي قبله.</p>
          <div class="subscription-spotlight-actions">
            <a class="btn btn-primary" href="<%= homeSubscriptionHref %>"><%= homeSubscriptionCta %> <span>↙</span></a>
            <a class="btn btn-secondary" href="#market">تصفح المشاريع</a>
          </div>
          <div class="subscription-spotlight-proof" aria-label="مزايا العضوية">
            <span><b>01</b> خصم على كل شراء</span>
            <span><b>02</b> إطلاقات قبل الجميع</span>
            <span><b>03</b> دعم حسب مستواك</span>
          </div>
          <% if (homeActivePlan) { %>
            <a class="subscription-spotlight-current" href="/membership">
              <span>عضويتك الحالية</span>
              <strong><%= homeActivePlan.name %></strong>
              <small>إدارة المزايا والخصم ↙</small>
            </a>
          <% } %>
        </div>

        <div class="subscription-spotlight-visual" aria-hidden="true">
          <div class="subscription-spotlight-orbit subscription-spotlight-orbit-one"></div>
          <div class="subscription-spotlight-orbit subscription-spotlight-orbit-two"></div>
          <div class="subscription-spotlight-score">
            <span>VALUE / MEMBERSHIP</span>
            <strong><%= homeMaxDiscount %><small>%</small></strong>
            <em>خصم أقصى على المشاريع</em>
          </div>
          <div class="subscription-spotlight-tiers">
            <% homeSubscriptionPlans.slice(0, 3).forEach((plan, index) => { %>
              <div class="subscription-spotlight-tier subscription-spotlight-tier-<%= index + 1 %>">
                <b><%= plan.name %></b>
                <span><%= displayMoney(plan.price) %> / <%= plan.durationDays || 30 %> يوم</span>
              </div>
            <% }) %>
          </div>
          <span class="subscription-spotlight-tag subscription-spotlight-tag-top">SMART BUYING</span>
          <span class="subscription-spotlight-tag subscription-spotlight-tag-bottom">BUILD MORE / SPEND LESS</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="لماذا Codentra">
    <div class="container trust-strip-grid">
      <div class="trust-strip-intro">
        <span class="section-kicker">ليه Codentra؟</span>
        <h2>أقل وقت.<br><span>شغل أكتر.</span></h2>
      </div>
      <div class="trust-signal"><span class="trust-signal-icon">↗</span><div><strong>ابدأ فورًا</strong><p>كود المصدر جاهز للتحميل بعد الشراء.</p></div></div>
      <div class="trust-signal"><span class="trust-signal-icon">⌁</span><div><strong>قارن بذكاء</strong><p>قارن حتى 3 مشاريع قبل ما تقرر.</p></div></div>
      <div class="trust-signal"><span class="trust-signal-icon">◌</span><div><strong>اطلب تخصيصك</strong><p>حوّل الفكرة لمنتج يناسب احتياجك.</p></div></div>
    </div>
  </section>

  <section class="phase2-rail" aria-label="Codentra workflow">
    <div class="container phase2-rail-inner">
      <span class="phase2-rail-label">CODENTRA WORKFLOW</span>
      <div class="phase2-rail-track" aria-hidden="true">
        <span>IDEA</span><i>✦</i><span>BUILD</span><i>✦</i><span>SHIP</span><i>✦</i><span>REPEAT</span><i>✦</i><span>IDEA</span><i>✦</i><span>BUILD</span>
      </div>
      <a class="phase2-rail-cta" href="/custom-project">خلّي فكرتك تبدأ <span>↙</span></a>
    </div>
  </section>

  <% if (safeRecentProjects.length > 0) { %>
    <section class="projects-section recently-viewed-section">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="section-kicker">متابعة سريعة</span>
            <h2>شوهد مؤخرًا</h2>
          </div>
          <p class="section-copy">ارجع بسرعة لآخر المشاريع التي فتحتها وكمل من حيث توقفت.</p>
        </div>

        <div class="projects-grid recent-projects-grid">
          <% safeRecentProjects.forEach(project => { %>
            <div class="project-card project-card-recent">
              <div class="project-image <%= project.images && project.images.length > 0 ? 'has-cover' : '' %>" style="position:relative;">
                <% if (project.images && project.images.length > 0) { %>
                  <img src="<%= String(project.images[0] || '').startsWith('/') ? project.images[0] : '/' + project.images[0] %>" alt="<%= project.title %>" class="project-cover" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('image-failed');">
                  <span class="image-fallback-label"><%= project.title %></span>
                <% } else { %>
                  <div class="placeholder-img">
                    <span><%= project.title %></span>
                  </div>
                <% } %>
              </div>
              <div class="project-info">
                <% const isWishlistedRecent = user && user.role === 'user' && Array.isArray(wishlistProjectIds) && wishlistProjectIds.includes(project.id); %>
                <% if (user && user.role === 'user') { %>
                  <form action="/wishlist/toggle" method="POST" class="wishlist-form">
                    <input type="hidden" name="projectId" value="<%= project.id %>">
                    <button type="submit" class="wishlist-btn <%= isWishlistedRecent ? 'is-active' : '' %>" aria-label="<%= isWishlistedRecent ? 'إزالة من المفضلة' : 'إضافة للمفضلة' %>" aria-pressed="<%= isWishlistedRecent ? 'true' : 'false' %>">
                      <%= isWishlistedRecent ? '♥' : '♡' %>
                    </button>
                  </form>
                <% } %>
                <span class="project-card-eyebrow">آخر زيارة</span>
                <h3><%= project.title %></h3>
                <% if (project.visibility && project.visibility !== 'public') { %>
                  <div style="margin-top:6px;">
                    <span class="trust-badge trust-badge-last">
                      <% if (project.visibility === 'subscribers') { %>للمشتركين فقط<% } else if (project.visibility === 'starter' || project.visibility === 'basic') { %>Starter فما فوق<% } else if (project.visibility === 'pro') { %>Pro فما فوق<% } else if (project.visibility === 'business' || project.visibility === 'premium') { %>Business فقط<% } %>
                    </span>
                  </div>
                <% } %>
                <p class="project-desc"><%= project.description.substring(0, 100) %><%= project.description.length > 100 ? '...' : '' %></p>
                <div class="project-tech">
                  <% project.technologies.slice(0, 3).forEach(tech => { %>
                    <span class="tech-tag"><%= tech %></span>
                  <% }) %>
                </div>
                <div class="project-footer">
                <% if (project.sale && project.sale.active) { %>
                  <span class="price sale-price"><%= displayMoney(project.finalPrice) %></span>
                  <small style="display:block;opacity:.7;text-decoration:line-through;"><%= displayMoney(project.originalPrice) %></small>
                  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:6px;">
                    <span class="sale-badge"><%= project.sale.saleType === 'percent' ? ('-' + project.sale.saleValue + '%') : 'SALE' %></span>
                    <small style="display:block;color:#7df2b8;">
                      <% if (project.sale.saleType === 'percent') { %>
                        خصم <%= project.sale.saleValue %>%
                      <% } else { %>
                        خصم <%= displayMoney(project.sale.discountAmount) %>
                      <% } %>
                      <%= project.sale.occasion ? '• ' + project.sale.occasion : '' %>
                    </small>
                  </div>
                <% } else { %>
                  <span class="price"><%= displayMoney(project.price) %></span>
                <% } %>
                  <a href="/project/<%= project.id %>" class="btn btn-secondary">متابعة</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <section class="projects-section" id="market">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-kicker">السوق</span>
          <h2>المشاريع المتاحة</h2>
        </div>
        <p class="section-copy">تصفح كل المشاريع الجاهزة واختر المشروع الأنسب لاحتياجك الحالي.</p>
      </div>

      <% const marketTechnologies = Array.from(new Set(projects.flatMap(project => Array.isArray(project.technologies) ? project.technologies : []))).filter(Boolean).sort((a, b) => String(a).localeCompare(String(b), 'ar')); %>
      <form class="market-filter-bar" id="marketFilterForm" role="search">
        <label class="market-search-field">
          <span class="market-filter-icon">⌕</span>
          <input id="marketSearch" type="search" placeholder="دور على مشروع، تقنية، أو فكرة..." autocomplete="off">
        </label>
        <div class="market-filter-select market-dropdown" data-market-dropdown="marketCategory">
          <span>النوع</span>
          <button type="button" class="market-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span class="market-dropdown-value">كل الأنواع</span><b>⌄</b>
          </button>
          <div class="market-dropdown-menu" role="listbox" hidden>
            <button type="button" role="option" data-value="">كل الأنواع</button>
            <button type="button" role="option" data-value="Web">ويب</button>
            <button type="button" role="option" data-value="Mobile">موبايل</button>
            <button type="button" role="option" data-value="Desktop">ديسكتوب</button>
            <button type="button" role="option" data-value="API">API</button>
            <button type="button" role="option" data-value="Other">أخرى</button>
          </div>
          <select id="marketCategory" class="market-native-select" tabindex="-1" aria-hidden="true">
            <option value="">كل الأنواع</option><option value="Web">ويب</option><option value="Mobile">موبايل</option><option value="Desktop">ديسكتوب</option><option value="API">API</option><option value="Other">أخرى</option>
          </select>
        </div>
        <div class="market-filter-select market-dropdown" data-market-dropdown="marketTechnology">
          <span>التقنية</span>
          <button type="button" class="market-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span class="market-dropdown-value">كل التقنيات</span><b>⌄</b>
          </button>
          <div class="market-dropdown-menu" role="listbox" hidden>
            <button type="button" role="option" data-value="">كل التقنيات</button>
            <% marketTechnologies.forEach(technology => { %>
              <button type="button" role="option" data-value="<%= technology %>"><%= technology %></button>
            <% }) %>
          </div>
          <select id="marketTechnology" class="market-native-select" tabindex="-1" aria-hidden="true">
            <option value="">كل التقنيات</option>
            <% marketTechnologies.forEach(technology => { %><option value="<%= technology %>"><%= technology %></option><% }) %>
          </select>
        </div>
        <div class="market-filter-select market-sort-select market-dropdown" data-market-dropdown="marketSort">
          <span>ترتيب</span>
          <button type="button" class="market-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span class="market-dropdown-value">الأكثر صلة</span><b>⌄</b>
          </button>
          <div class="market-dropdown-menu" role="listbox" hidden>
            <button type="button" role="option" data-value="featured">الأكثر صلة</button>
            <button type="button" role="option" data-value="newest">الأحدث</button>
            <button type="button" role="option" data-value="best-selling">الأكثر مبيعًا</button>
            <button type="button" role="option" data-value="price-low">السعر: الأقل أولًا</button>
            <button type="button" role="option" data-value="price-high">السعر: الأعلى أولًا</button>
          </div>
          <select id="marketSort" class="market-native-select" tabindex="-1" aria-hidden="true">
            <option value="featured">الأكثر صلة</option><option value="newest">الأحدث</option><option value="best-selling">الأكثر مبيعًا</option><option value="price-low">السعر: الأقل أولًا</option><option value="price-high">السعر: الأعلى أولًا</option>
          </select>
        </div>
        <button type="reset" class="market-reset" id="marketReset">مسح</button>
        <div class="market-results-count" id="marketResultsCount" aria-live="polite"><%= projects.length %> مشروع</div>
      </form>

      <div class="projects-grid" id="marketGrid">
        <% projects.forEach(project => { %>
          <div class="project-card market-project-card"
            data-title="<%= project.title %>"
            data-description="<%= project.description %>"
            data-category="<%= project.category || '' %>"
            data-technologies="<%= (project.technologies || []).join(' ') %>"
            data-price="<%= Number(project.finalPrice || project.price || 0) %>"
            data-sales="<%= project.trustSignals ? Number(project.trustSignals.salesCount || 0) : 0 %>"
            data-featured="<%= project.trustSignals && project.trustSignals.isTopSeller ? '1' : '0' %>"
            data-created-at="<%= project.createdAt || '' %>">
            <div class="project-image <%= project.images && project.images.length > 0 ? 'has-cover' : '' %>" style="position:relative;">
              <% if (project.visibility && project.visibility !== 'public') { %>
                <span class="sale-badge" style="position:absolute; top:12px; right:12px; z-index:2;">
                  <% if (project.visibility === 'subscribers') { %>
                    للمشتركين
                  <% } else if (project.visibility === 'starter' || project.visibility === 'basic') { %>
                    Starter
                  <% } else if (project.visibility === 'pro') { %>
                    Pro
                  <% } else if (project.visibility === 'business' || project.visibility === 'premium') { %>
                    Business
                  <% } %>
                </span>
              <% } %>
              <% if (project.images && project.images.length > 0) { %>
                <img src="<%= String(project.images[0] || '').startsWith('/') ? project.images[0] : '/' + project.images[0] %>" alt="<%= project.title %>" class="project-cover" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('image-failed');">
                <span class="image-fallback-label"><%= project.title %></span>
              <% } else { %>
                <div class="placeholder-img">
                  <span><%= project.title %></span>
                </div>
              <% } %>
            </div>
            <div class="project-info">
              <% const isWishlisted = user && user.role === 'user' && Array.isArray(wishlistProjectIds) && wishlistProjectIds.includes(project.id); %>
              <% if (user && user.role === 'user') { %>
                <form action="/wishlist/toggle" method="POST" class="wishlist-form">
                  <input type="hidden" name="projectId" value="<%= project.id %>">
                  <button type="submit" class="wishlist-btn <%= isWishlisted ? 'is-active' : '' %>" aria-label="<%= isWishlisted ? 'إزالة من المفضلة' : 'إضافة للمفضلة' %>" aria-pressed="<%= isWishlisted ? 'true' : 'false' %>">
                    <%= isWishlisted ? '♥' : '♡' %>
                  </button>
                </form>
              <% } %>
              <h3><%= project.title %></h3>
              <% if (project.visibility && project.visibility !== 'public') { %>
                <div style="margin-top:6px;">
                  <span class="trust-badge trust-badge-last">
                    <% if (project.visibility === 'subscribers') { %>للمشتركين فقط<% } else if (project.visibility === 'starter' || project.visibility === 'basic') { %>Starter فما فوق<% } else if (project.visibility === 'pro') { %>Pro فما فوق<% } else if (project.visibility === 'business' || project.visibility === 'premium') { %>Business فقط<% } %>
                  </span>
                </div>
              <% } %>
              <% if (project.trustSignals && (project.trustSignals.isTopSeller || project.trustSignals.lastPurchaseText)) { %>
                <div class="trust-signals">
                  <% if (project.trustSignals.isTopSeller) { %>
                    <span class="trust-badge trust-badge-top">الأكثر مبيعًا</span>
                  <% } %>
                  <% if (project.trustSignals.lastPurchaseText) { %>
                    <span class="trust-badge trust-badge-last"><%= project.trustSignals.lastPurchaseText %></span>
                  <% } %>
                </div>
              <% } %>
              <p class="project-desc"><%= project.description.substring(0, 100) %><%= project.description.length > 100 ? '...' : '' %></p>
              <div class="project-tech">
                <% project.technologies.slice(0, 3).forEach(tech => { %>
                  <span class="tech-tag"><%= tech %></span>
                <% }) %>
              </div>
              <div class="project-footer">
                <% if (project.sale && project.sale.active) { %>
                  <span class="price sale-price"><%= displayMoney(project.finalPrice) %></span>
                  <small style="display:block;opacity:.7;text-decoration:line-through;"><%= displayMoney(project.originalPrice) %></small>
                  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:6px;">
                    <span class="sale-badge"><%= project.sale.saleType === 'percent' ? ('-' + project.sale.saleValue + '%') : 'SALE' %></span>
                    <small style="display:block;color:#7df2b8;">
                      <% if (project.sale.saleType === 'percent') { %>
                        خصم <%= project.sale.saleValue %>%
                      <% } else { %>
                        خصم <%= displayMoney(project.sale.discountAmount) %>
                      <% } %>
                      <%= project.sale.occasion ? '• ' + project.sale.occasion : '' %>
                    </small>
                  </div>
                <% } else { %>
                  <span class="price"><%= displayMoney(project.price) %></span>
                <% } %>
                <a href="/project/<%= project.id %>" class="btn btn-primary">تفاصيل</a>
              </div>
              <button type="button" class="btn btn-secondary compare-toggle-btn" data-project-id="<%= project.id %>">أضف للمقارنة</button>
            </div>
          </div>
        <% }) %>
      </div>
      
      <% if (projects.length === 0) { %>
        <div class="empty-state">
          <p>لا توجد مشاريع متاحة حاليًا</p>
        </div>
      <% } %>
      <div class="empty-state market-filter-empty" id="marketFilterEmpty" hidden>
        <p>مفيش مشروع مطابق للبحث الحالي.</p>
        <button type="button" class="btn btn-secondary" id="marketEmptyReset">عرض كل المشاريع</button>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <button type="button" id="compareFab" class="compare-fab" hidden>⚖️ <span id="compareFabCount">0</span></button>
  <div id="compareTray" class="compare-tray" hidden>
    <div class="compare-tray-copy">
      <strong>المقارنة الذكية</strong>
      <span id="compareTrayCount">0/3</span>
    </div>
    <div class="compare-tray-actions">
      <button type="button" class="btn btn-secondary" id="clearCompareBtn">مسح</button>
      <button type="button" class="btn btn-secondary" id="closeCompareTrayBtn">إغلاق</button>
      <a href="/compare" class="btn btn-primary" id="goCompareBtn">قارن الآن</a>
    </div>
  </div>
  <script>
    (() => {
      const banner = document.querySelector('.release-banner');
      const bannerCopy = banner ? banner.querySelector('.release-banner-copy') : null;
      const bannerMark = banner ? banner.querySelector('.release-banner-mark') : null;
      if (!banner) return;

      let ticking = false;

      const updateBannerScrollFx = () => {
        const scrollY = window.scrollY || window.pageYOffset || 0;
        const progress = Math.max(0, Math.min(1, scrollY / 360));
        const bannerLift = progress * -26;
        const bannerScale = 1 - (progress * 0.045);
        const copyShift = progress * -20;
        const markShift = progress * 26;
        const markTilt = progress * -12;
        const fade = 1 - (progress * 0.18);

        banner.style.transform = `translate3d(0, ${bannerLift}px, 0) scale(${bannerScale})`;
        banner.style.opacity = String(fade);

        if (bannerCopy) {
          bannerCopy.style.transform = `translate3d(${copyShift}px, ${progress * -6}px, 0)`;
        }

        if (bannerMark) {
          bannerMark.style.transform = `translate3d(${markShift}px, ${progress * -4}px, 0) rotateY(${markTilt}deg)`;
        }

        ticking = false;
      };

      const queueUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateBannerScrollFx);
      };

      updateBannerScrollFx();
      window.addEventListener('scroll', queueUpdate, { passive: true });
      window.addEventListener('resize', queueUpdate, { passive: true });
    })();
  </script>
  <script>
    (() => {
      const KEY = 'compare_projects';
      const MAX = 3;
      const tray = document.getElementById('compareTray');
      const fab = document.getElementById('compareFab');
      const fabCount = document.getElementById('compareFabCount');
      const countNode = document.getElementById('compareTrayCount');
      const clearBtn = document.getElementById('clearCompareBtn');
      const closeTrayBtn = document.getElementById('closeCompareTrayBtn');
      const goBtn = document.getElementById('goCompareBtn');
      const toggles = Array.from(document.querySelectorAll('.compare-toggle-btn'));
      if (!tray || !countNode || !goBtn || !fab || !fabCount) return;

      const getIds = () => {
        try {
          const arr = JSON.parse(localStorage.getItem(KEY) || '[]');
          return Array.isArray(arr) ? arr.filter(Boolean).slice(0, MAX) : [];
        } catch (_) { return []; }
      };
      const setIds = (ids) => localStorage.setItem(KEY, JSON.stringify(ids.slice(0, MAX)));

      const render = () => {
        const ids = getIds();
        fab.hidden = false;
        if (ids.length === 0) {
          tray.hidden = true;
          tray.classList.remove('is-open');
        }
        countNode.textContent = `${ids.length}/3`;
        fabCount.textContent = String(ids.length);
        goBtn.href = `/compare?ids=${encodeURIComponent(ids.join(','))}`;
        toggles.forEach((btn) => {
          const id = btn.getAttribute('data-project-id');
          const active = ids.includes(id);
          btn.textContent = active ? 'إزالة من المقارنة' : 'أضف للمقارنة';
          btn.classList.toggle('is-active', active);
        });
      };

      toggles.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-project-id');
          let ids = getIds();
          if (ids.includes(id)) {
            ids = ids.filter((x) => x !== id);
          } else {
            if (ids.length >= MAX) ids.shift();
            ids.push(id);
          }
          setIds(ids);
          render();
        });
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          setIds([]);
          render();
        });
      }
      if (closeTrayBtn) {
        closeTrayBtn.addEventListener('click', () => {
          tray.hidden = true;
          tray.classList.remove('is-open');
        });
      }
      fab.addEventListener('click', () => {
        const willOpen = tray.hidden;
        tray.hidden = !willOpen;
        tray.classList.toggle('is-open', willOpen);
      });

      tray.hidden = true;
      tray.classList.remove('is-open');
      render();
    })();
  </script>
</body>
</html>
