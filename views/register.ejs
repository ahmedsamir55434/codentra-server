<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إنشاء حساب - Codentra</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="auth-page">
    <div class="container">
      <div class="auth-box">
        <h2>إنشاء حساب جديد</h2>
        <% if (error) { %>
          <div class="error-message"><%= error %></div>
        <% } %>
        <% if (googleAuthEnabled) { %>
          <a href="/auth/google?mode=register<%= referralPrefill ? `&ref=${encodeURIComponent(referralPrefill)}` : '' %>" class="google-auth-btn" aria-label="إنشاء حساب باستخدام جوجل">
            <span class="google-auth-icon">G</span>
            <span>إنشاء حساب باستخدام جوجل</span>
          </a>
        <% } %>
        <% if (githubAuthEnabled) { %>
          <a href="/auth/github?mode=register<%= referralPrefill ? `&ref=${encodeURIComponent(referralPrefill)}` : '' %>" class="github-auth-btn" aria-label="إنشاء حساب باستخدام GitHub">
            <span class="github-auth-icon">GH</span>
            <span>إنشاء حساب باستخدام GitHub</span>
          </a>
        <% } %>
        <% if (googleAuthEnabled || githubAuthEnabled) { %>
          <div class="auth-divider"><span>أو أكمل يدويًا</span></div>
        <% } %>
        <form action="/register" method="POST">
          <div class="form-group">
            <label for="name">الاسم الكامل</label>
            <input type="text" id="name" name="name" required>
          </div>
          <div class="form-group">
            <label for="email">البريد الإلكتروني</label>
            <input type="email" id="email" name="email" required>
          </div>
          <div class="form-group">
            <label for="password">كلمة المرور</label>
            <input type="password" id="password" name="password" required minlength="6">
          </div>
          <div class="form-group">
            <label for="walletPassword">كلمة مرور البطاقة</label>
            <input type="password" id="walletPassword" name="walletPassword" required minlength="4" placeholder="تُستخدم عند الدفع بالمبالغ الكبيرة">
          </div>
          <div class="form-group">
            <label for="referralCode">كود الإحالة (اختياري)</label>
            <input type="text" id="referralCode" name="referralCode" value="<%= referralPrefill || '' %>" placeholder="مثال: A1B2C3D4">
          </div>
          <button type="submit" class="btn btn-primary btn-full">إنشاء الحساب</button>
        </form>
        <p class="auth-link">لديك حساب بالفعل؟ <a href="/login">تسجيل الدخول</a></p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
