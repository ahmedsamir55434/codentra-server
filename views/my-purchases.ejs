<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'ar' %>" dir="<%= dir || (lang === 'en' ? 'ltr' : 'rtl') %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>مشترياتي - Codentra</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/purchases.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="purchases-page">
    <div class="container">
      <h1>مشترياتي</h1>

      <% if (paymentError) { %>
        <div class="error-message"><%= paymentError %></div>
      <% } %>

      <% if (paymentSuccess) { %>
        <div class="success-message"><%= paymentSuccess %></div>
      <% } %>

      <% if (user && (user.referralCode || Number(user.walletBalance || 0) > 0)) { %>
        <div class="purchase-card stacked-card" style="margin-bottom: 16px;">
          <div class="purchase-info">
            <h3 style="margin-top: 0;">الإحالة ورصيد المحفظة</h3>
            <p style="margin: 0 0 8px;">رصيد المحفظة: <strong><%= displayMoney(user.walletBalance || 0) %></strong></p>
            <% if (user.referralCode) { %>
              <div class="referral-box">
                <div class="referral-box-head">
                  <strong>كود الإحالة الخاص بك</strong>
                  <span class="wallet-code-badge"><%= user.referralCode %></span>
                </div>
                <p class="wallet-card-note">عندما يسجل شخص باستخدام كودك تحصل على <strong>50 نقطة</strong> فورًا، وعندما يكمل أول شراء معتمد تحصل على <strong>100 نقطة</strong> إضافية.</p>
                <div class="referral-actions">
                  <input
                    type="text"
                    id="referralLink"
                    class="referral-link-input"
                    value="<%= referralLink || '' %>"
                    readonly>
                  <button type="button" class="btn btn-secondary" id="copyReferralLink">نسخ رابط الدعوة</button>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>

      <div class="purchase-card stacked-card" style="margin-bottom: 16px;">
        <div class="purchase-info">
          <h3 style="margin-top: 0;">شحن الرصيد عبر Atlos</h3>
          <p class="wallet-card-note">الموقع يعرض الأسعار بالدولار تلقائيًا بحسب سعر اليوم، وسيتم إنشاء عملية الشحن عبر بوابة Atlos بنفس قيمة الدولار التي تدخلها.</p>
          <% if (atlosEnabled) { %>
            <form action="/wallet/topup/start" method="POST" class="wallet-topup-form" style="margin-top: 12px;">
              <div class="form-group">
                <label for="topupAmount">مبلغ الشحن</label>
                <input type="number" id="topupAmount" name="amount" min="0.01" step="0.01" placeholder="مثال: 25" required>
              </div>
              <div class="wallet-topup-presets">
                <button type="button" class="btn btn-secondary topup-preset-btn" data-topup-amount="10">$10</button>
                <button type="button" class="btn btn-secondary topup-preset-btn" data-topup-amount="25">$25</button>
                <button type="button" class="btn btn-secondary topup-preset-btn" data-topup-amount="50">$50</button>
                <button type="button" class="btn btn-secondary topup-preset-btn" data-topup-amount="100">$100</button>
              </div>
              <button type="submit" class="btn btn-primary">اشحن الآن</button>
            </form>
          <% } else { %>
            <div class="error-message">إعدادات Atlos غير مكتملة بعد. أضف `ATLOS_API_URL` و`ATLOS_API_KEY` أولًا.</div>
          <% } %>
        </div>
      </div>

      <% if (walletTopups && walletTopups.length) { %>
        <div class="purchase-card stacked-card" style="margin-bottom: 16px;">
          <div class="purchase-info">
            <h3 style="margin-top: 0;">سجل شحن الرصيد</h3>
          </div>
          <div class="wallet-activity-list">
            <% walletTopups.forEach(topup => { %>
              <div class="wallet-activity-item">
                <div class="wallet-activity-head">
                  <strong>شحن رصيد <%= formatUsdAmount(topup.amountUsd || convertEgpToUsd(topup.amount || 0)) %></strong>
                  <span class="status-badge <%= topup.status === 'paid' ? 'approved' : topup.status === 'failed' ? 'rejected' : 'pending' %>">
                    <%= topup.status === 'paid' ? 'تم الدفع' : topup.status === 'failed' ? 'عملية غير ناجحة' : 'بانتظار الدفع' %>
                  </span>
                </div>
                <div class="wallet-activity-meta">
                  <span>المرجع: <strong><%= topup.reference %></strong></span>
                  <span>الحالة: <strong><%= topup.status === 'paid' ? 'تم الدفع' : topup.status === 'failed' ? 'عملية غير ناجحة' : 'بانتظار الدفع' %></strong></span>
                  <span><%= new Date(topup.createdAt).toLocaleString('ar-EG') %></span>
                </div>
                <% if (topup.status !== 'paid' && topup.checkoutUrl) { %>
                  <div style="margin-top: 10px;">
                    <a href="<%= topup.checkoutUrl %>" class="btn btn-secondary">استكمال الدفع</a>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="purchase-card" style="margin-bottom: 16px;">
        <div class="purchase-info">
          <h3 style="margin-top: 0;">بطاقة المحفظة</h3>
          <% if (walletCardError) { %>
            <div class="error-message"><%= walletCardError %></div>
          <% } %>
          <% if (walletCardSuccess) { %>
            <div class="success-message"><%= walletCardSuccess %></div>
          <% } %>
          <p style="margin: 0 0 8px;">رقم البطاقة: <strong><%= walletCardNumber || '-' %></strong></p>
          <p style="margin: 0 0 8px;">حالة البطاقة:
            <% if (walletCardFrozen) { %>
              <span style="color: #dc3545; font-weight: bold;">🚫 مجمدة</span>
            <% } else { %>
              <span style="color: #28a745; font-weight: bold;">✅ نشطة</span>
            <% } %>
          </p>
          <p style="margin: 0 0 8px;">حد البطاقة الحالي:
            <strong><%= walletCardSpendingLimit != null ? displayMoney(walletCardSpendingLimit) : 'بدون حد' %></strong>
          </p>
          <p class="wallet-card-note">أي مستخدم يمكنه طلب الدفع بهذه البطاقة، لكن كود التحقق سيظهر لك هنا في تنبيهات البطاقة. وإذا كنت أنت صاحب البطاقة وتدفع بنفسك فلن يطلب منك كود تحقق.</p>
          <form action="/wallet-card/freeze" method="POST" style="margin: 10px 0;">
            <button type="submit" class="btn <%= walletCardFrozen ? 'btn-success' : 'btn-danger' %>">
              <%= walletCardFrozen ? '🔓 فك تجميد البطاقة' : '🚫 تجميد البطاقة' %>
            </button>
          </form>
          <form action="/wallet-card/password" method="POST" style="margin-top: 10px;">
            <div class="form-group">
              <label for="walletPassword">تعيين أو تغيير كلمة مرور البطاقة</label>
              <input type="password" id="walletPassword" name="walletPassword" placeholder="اختياري - لا يقل عن 4 أحرف">
            </div>
            <div class="form-group">
              <label for="walletCardSpendingLimit">حد البطاقة لكل عملية</label>
              <input
                type="number"
                id="walletCardSpendingLimit"
                name="walletCardSpendingLimit"
                min="1"
                step="0.01"
                value="<%= walletCardSpendingLimit != null ? displayMoneyValue(walletCardSpendingLimit) : '' %>"
                placeholder="مثال: 80">
            </div>
            <button type="submit" class="btn btn-secondary">حفظ إعدادات البطاقة</button>
          </form>
        </div>
      </div>

      <% if (incomingApprovals && incomingApprovals.length) { %>
        <div class="purchase-card stacked-card" style="margin-bottom: 16px;">
          <div class="purchase-info">
            <h3 style="margin-top: 0;">طلبات استخدام بطاقتك الآن</h3>
            <p class="wallet-card-note">هذه الطلبات لم تُستكمل بعد. شارك الكود فقط إذا كنت موافقًا على الدفع.</p>
          </div>
          <div class="wallet-activity-list">
            <% incomingApprovals.forEach(attempt => { %>
              <div class="wallet-activity-item">
                <div class="wallet-activity-head">
                  <strong><%= attempt.purposeLabel || 'استخدام بطاقة المحفظة' %></strong>
                  <span class="wallet-code-badge"><%= attempt.ownerVisibleCode %></span>
                </div>
                <div class="wallet-activity-meta">
                  <span>المبلغ: <strong><%= displayMoney(attempt.amount || 0) %></strong></span>
                  <span>الطالب: <strong><%= attempt.buyerDisplayName || 'مستخدم' %></strong></span>
                  <span>ينتهي: <strong><%= new Date(attempt.expiresAt).toLocaleString('ar-EG') %></strong></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (walletCardNotifications && walletCardNotifications.length) { %>
        <div class="purchase-card stacked-card" style="margin-bottom: 16px;">
          <div class="purchase-info">
            <h3 style="margin-top: 0;">إشعارات البطاقة</h3>
          </div>
          <div class="wallet-activity-list">
            <% walletCardNotifications.forEach(notification => { %>
              <div class="wallet-activity-item">
                <div class="wallet-activity-head">
                  <strong><%= notification.title %></strong>
                  <% if (notification.metadata && notification.metadata.verificationCode) { %>
                    <span class="wallet-code-badge"><%= notification.metadata.verificationCode %></span>
                  <% } %>
                </div>
                <p class="wallet-activity-message"><%= notification.message %></p>
                <div class="wallet-activity-meta">
                  <% if (notification.metadata && notification.metadata.amount != null) { %>
                    <span>المبلغ: <strong><%= displayMoney(notification.metadata.amount) %></strong></span>
                  <% } %>
                  <% if (notification.metadata && notification.metadata.purposeLabel) { %>
                    <span>الغرض: <strong><%= notification.metadata.purposeLabel %></strong></span>
                  <% } %>
                  <span><%= new Date(notification.createdAt).toLocaleString('ar-EG') %></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (walletCardUsageLog && walletCardUsageLog.length) { %>
        <div class="purchase-card stacked-card" style="margin-bottom: 16px;">
          <div class="purchase-info">
            <h3 style="margin-top: 0;">سجل استخدام البطاقة</h3>
          </div>
          <div class="wallet-activity-list">
            <% walletCardUsageLog.forEach(entry => { %>
              <div class="wallet-activity-item">
                <div class="wallet-activity-head">
                  <strong><%= entry.purposeLabel %></strong>
                  <span class="wallet-limit-badge status-<%= entry.status %>"><%= entry.status === 'completed' ? 'مكتمل' : entry.status === 'pending_verification' ? 'بانتظار التحقق' : entry.status === 'expired' ? 'منتهي' : 'تم الاستخدام' %></span>
                </div>
                <p class="wallet-activity-message">
                  <strong><%= entry.buyerName || 'مستخدم' %></strong>
                  استخدم البطاقة بمبلغ
                  <strong><%= displayMoney(entry.amount || 0) %></strong>
                </p>
                <% if (entry.note) { %>
                  <p class="wallet-activity-note"><%= entry.note %></p>
                <% } %>
                <div class="wallet-activity-meta">
                  <span><%= new Date(entry.createdAt).toLocaleString('ar-EG') %></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="purchase-card stacked-card" style="margin-bottom: 16px;">
        <div class="purchase-info">
          <h3 style="margin-top: 0;">أكواد شحن الرصيد</h3>
          <% if (redeemError) { %>
            <div class="error-message"><%= redeemError %></div>
          <% } %>
          <% if (redeemSuccess) { %>
            <div class="success-message"><%= redeemSuccess %></div>
          <% } %>
          <p class="wallet-card-note">إذا أعطاك الأدمن كود شحن، اكتبه هنا وسيتم إضافة الرصيد مباشرة إلى محفظتك إذا كان الكود صالحًا.</p>
          <form action="/wallet/redeem" method="POST" style="margin-top: 10px;">
            <div class="form-group">
              <label for="walletCode">كود الشحن</label>
              <input type="text" id="walletCode" name="code" placeholder="مثال: TOPUP100" required>
            </div>
            <button type="submit" class="btn btn-primary">إضافة الرصيد</button>
          </form>
        </div>
      </div>

      <% if (subscriptionPayments && subscriptionPayments.length) { %>
        <div class="purchase-card" style="margin-bottom: 16px;">
          <div class="purchase-info">
            <h3 style="margin-top: 0;">اشتراكاتي</h3>
            <div class="purchase-meta" style="margin-top: 10px;">
              <span>عدد عمليات الاشتراك: <strong><%= subscriptionPayments.length %></strong></span>
            </div>
          </div>
        </div>

        <div class="purchases-list">
          <% 
            const _subPlans = Array.isArray(subscriptionPlans) ? subscriptionPlans : [];
            const _subs = Array.isArray(subscriptions) ? subscriptions : [];
            const _subPayments = Array.isArray(subscriptionPayments) ? subscriptionPayments : [];
            const _sortedSubPayments = _subPayments.slice().sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
          %>
          <% _sortedSubPayments.forEach(pay => { 
            const plan = _subPlans.find(p => p.id === pay.planId) || null;
            const sub = _subs.find(s => s.id === pay.subscriptionId) || null;
            const before = (pay.priceBefore != null) ? Number(pay.priceBefore) : Number(pay.amount || 0);
            const discount = Number(pay.discountAmount || 0);
            const after = Number(pay.amount || 0);
          %>
            <div class="purchase-card">
              <div class="purchase-info">
                <h3><%= plan ? plan.name : (pay.planId || 'Subscription') %></h3>
                <div class="purchase-meta">
                  <span class="purchase-date"><%= pay.createdAt ? new Date(pay.createdAt).toLocaleDateString('ar-EG') : '-' %></span>
                  <span class="purchase-price"><%= displayMoney(after) %></span>
                  <% if (sub && sub.status === 'active') { %>
                    <span class="status-badge approved">✓ نشط</span>
                  <% } else if (sub && sub.status === 'canceled') { %>
                    <span class="status-badge rejected">✗ ملغي</span>
                  <% } %>
                </div>

                <% if (pay.couponCode && discount) { %>
                  <p class="modification-note">
                    كوبون: <strong><%= pay.couponCode %></strong>
                    | قبل: <%= before %> ج
                    | خصم: <%= discount %> ج
                    | بعد: <%= after %> ج
                  </p>
                <% } %>

                <% if (sub && sub.currentPeriodEnd) { %>
                  <p class="modification-note">ينتهي في: <%= new Date(sub.currentPeriodEnd).toLocaleDateString('ar-EG') %></p>
                <% } %>
              </div>
              <div class="purchase-actions">
                <a href="/subscriptions" class="btn btn-secondary">إدارة الاشتراك</a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
      
      <% if (purchases.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">🛒</div>
          <h2>لم تقم بأي مشتريات بعد</h2>
          <p>تصفح المشاريع واشتري ما يناسبك</p>
          <a href="/" class="btn btn-primary">تصفح المشاريع</a>
        </div>
      <% } else { %>
        <div class="purchases-list">
          <% purchases.forEach(purchase => { %>
            <% const orderId = purchase.orderId || purchase.id; %>
            <% const inv = (invoices || []).find(i => i && i.orderId === orderId); %>
            <div class="purchase-card">
              <div class="purchase-info">
                <h3><%= purchase.projectTitle %></h3>
                <div class="purchase-meta">
                  <span class="purchase-date">
                    <%= new Date(purchase.purchasedAt).toLocaleDateString('ar-EG') %>
                  </span>
                  <span class="purchase-price"><%= displayMoney(purchase.price) %></span>
                  <% if (purchase.status === 'pending') { %>
                    <span class="status-badge pending">⏳ بانتظار الموافقة</span>
                  <% } else if (purchase.status === 'approved') { %>
                    <span class="status-badge approved">✓ تمت الموافقة</span>
                  <% } else if (purchase.status === 'rejected') { %>
                    <span class="status-badge rejected">✗ تم الرفض</span>
                  <% } %>
                  <% if (purchase.isModified) { %>
                    <span class="modified-badge">📝 معدّل</span>
                  <% } %>
                </div>
                <% if (purchase.couponCode && purchase.discountAmount) { %>
                  <p class="modification-note">
                    كوبون: <strong><%= purchase.couponCode %></strong>
                    | قبل: <%= purchase.priceBefore %> ج
                    | خصم: <%= purchase.discountAmount %> ج
                    | بعد: <%= purchase.price %> ج
                  </p>
                <% } %>
                <% if (purchase.modificationNote) { %>
                  <p class="modification-note"><%= purchase.modificationNote %></p>
                <% } %>
                <% if (purchase.walletRefundAmount) { %>
                  <p class="modification-note" style="color: #28a745;">
                    تم استرداد مبلغ: <strong><%= displayMoney(purchase.walletRefundAmount) %></strong> للمحفظة
                  </p>
                <% } %>
              </div>
              <div class="purchase-actions">
                <% if (purchase.status === 'approved') { %>
                  <% if (purchase.filePath) { %>
                    <a href="/download/<%= purchase.id %>" class="btn btn-primary">تحميل الملفات</a>
                  <% } else { %>
                    <span class="no-files">الملفات غير متوفرة</span>
                  <% } %>
                  <% if (inv) { %>
                    <a href="/invoice/<%= orderId %>.pdf" class="btn btn-secondary" target="_blank">تحميل الفاتورة PDF</a>
                  <% } %>
                  <a href="/messages/purchase/<%= purchase.id %>" class="btn btn-secondary">محادثة الطلب</a>
                  <a href="/request-modification/<%= purchase.id %>" class="btn btn-secondary">طلب تعديل</a>
                <% } else if (purchase.status === 'pending') { %>
                  <a href="/messages/purchase/<%= purchase.id %>" class="btn btn-secondary">محادثة الطلب</a>
                  <span class="waiting-text">بانتظار موافقة الأدمن</span>
                <% } else { %>
                  <a href="/messages/purchase/<%= purchase.id %>" class="btn btn-secondary">محادثة الطلب</a>
                  <span class="rejected-text">تم رفض الطلب</span>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script>
    (function () {
      const amountInput = document.getElementById('topupAmount');
      if (!amountInput) return;
      document.querySelectorAll('.topup-preset-btn').forEach((button) => {
        button.addEventListener('click', () => {
          amountInput.value = button.getAttribute('data-topup-amount') || '';
          amountInput.focus();
        });
      });
    })();

    (function () {
      const copyBtn = document.getElementById('copyReferralLink');
      const referralInput = document.getElementById('referralLink');
      if (!copyBtn || !referralInput) return;

      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(referralInput.value);
          copyBtn.textContent = 'تم النسخ';
          setTimeout(() => {
            copyBtn.textContent = 'نسخ رابط الدعوة';
          }, 1500);
        } catch (error) {
          referralInput.select();
          document.execCommand('copy');
          copyBtn.textContent = 'تم النسخ';
          setTimeout(() => {
            copyBtn.textContent = 'نسخ رابط الدعوة';
          }, 1500);
        }
      });
    })();
  </script>
</body>
</html>
