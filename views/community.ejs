<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'ar' %>" dir="<%= dir || (lang === 'en' ? 'ltr' : 'rtl') %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= lang === 'en' ? 'Community' : 'المجتمع' %> - Codentra</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/community.css">
  <link rel="stylesheet" href="/css/glass-v3.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="community-page">
    <div class="container">
      <section class="community-hero">
        <div>
          <span class="community-eyebrow">Codentra Community</span>
          <h1>مجتمع Codentra</h1>
          <p>مكان واحد لبوستات الإدارة، التفاعل من الأعضاء، والوظائف المفتوحة داخل الشركة.</p>
        </div>
        <div class="community-hero-actions">
          <a href="#community-feed" class="btn btn-primary">البوستات</a>
          <a href="#jobs" class="btn btn-secondary">الوظائف</a>
          <% if (user && user.role === 'admin' && user.isSuperAdmin) { %>
            <a href="/admin/community/jobs" class="btn btn-secondary">إدارة الوظائف</a>
          <% } %>
        </div>
      </section>

      <% if (error) { %>
        <div class="error-message"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="success-message"><%= success %></div>
      <% } %>

      <% if (user && user.role === 'admin') { %>
        <section class="community-card community-composer">
          <div class="section-header">
            <h2>انشر بوست جديد</h2>
            <span class="community-meta-badge"><%= user.isSuperAdmin ? 'سوبر أدمن' : 'أدمن' %></span>
          </div>
          <form action="/community/posts" method="POST" enctype="multipart/form-data">
            <div class="form-group">
              <label for="communityPostContent">النص</label>
              <textarea id="communityPostContent" name="content" rows="5" placeholder="اكتب تحديث، خبر، إعلان أو أي رسالة للمجتمع..."></textarea>
            </div>
            <div class="form-group">
              <label for="communityPostMedia">صورة أو فيديو</label>
              <input id="communityPostMedia" type="file" name="media" accept="image/*,video/*">
              <div class="file-info">يمكنك النشر بصورة أو فيديو مع النص أو بدونه.</div>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">نشر البوست</button>
            </div>
          </form>
        </section>
      <% } else { %>
        <section class="community-card community-notice">
          <p>النشر داخل الكوميونتي متاح لفريق الإدارة فقط، لكنك تقدر تشوف البوستات وتتفاعل بالحساب العادي.</p>
        </section>
      <% } %>

      <section id="community-feed" class="community-section">
        <div class="section-header">
          <h2>أحدث البوستات</h2>
          <span class="community-meta-badge"><%= posts.length %> بوست</span>
        </div>

        <% if (!posts || posts.length === 0) { %>
          <div class="empty-state">
            <p>لسه مفيش بوستات منشورة في الكوميونتي.</p>
          </div>
        <% } else { %>
          <div class="community-feed">
            <% posts.forEach(post => { %>
              <article class="community-card community-post" id="post-<%= post.id %>">
                <div class="community-post-header">
                  <div>
                    <h3><%= post.authorName %></h3>
                    <p><%= post.authorIsSuperAdmin ? 'سوبر أدمن' : 'أدمن' %> - <%= new Date(post.createdAt).toLocaleString('ar-EG') %></p>
                  </div>
                  <div class="community-post-stats">
                    <span>❤️ <%= post.likeCount %></span>
                    <span>💬 <%= post.commentCount %></span>
                    <span>🔁 <%= post.shareCount %></span>
                  </div>
                </div>

                <% if (post.content) { %>
                  <p class="community-post-content"><%= post.content %></p>
                <% } %>

                <% if (post.mediaPath && post.mediaType === 'image') { %>
                  <img src="/<%= post.mediaPath %>" alt="بوست الكوميونتي" class="community-post-media">
                <% } %>

                <% if (post.mediaPath && post.mediaType === 'video') { %>
                  <video controls class="community-post-media">
                    <source src="/<%= post.mediaPath %>">
                    متصفحك لا يدعم تشغيل الفيديو.
                  </video>
                <% } %>

                <div class="community-post-actions">
                  <% if (user && user.role === 'user') { %>
                    <form action="/community/posts/<%= post.id %>/like" method="POST" class="inline-form">
                      <button type="submit" class="btn btn-secondary btn-sm"><%= post.isLikedByCurrentUser ? 'إلغاء اللايك' : 'لايك' %></button>
                    </form>
                    <form action="/community/posts/<%= post.id %>/share" method="POST" class="inline-form" data-share-form data-share-url="/community#post-<%= post.id %>">
                      <button type="submit" class="btn btn-secondary btn-sm">شير</button>
                    </form>
                  <% } else if (!user) { %>
                    <a href="/login" class="btn btn-secondary btn-sm">سجل دخول للتفاعل</a>
                  <% } else { %>
                    <span class="community-action-note">التفاعل متاح للحسابات العادية فقط</span>
                  <% } %>
                </div>

                <div class="community-comments">
                  <h4>التعليقات</h4>
                  <% if (post.comments && post.comments.length) { %>
                    <div class="community-comments-list">
                      <% post.comments.forEach(comment => { %>
                        <div class="community-comment">
                          <div class="community-comment-header">
                            <strong><%= comment.userName %></strong>
                            <span><%= new Date(comment.createdAt).toLocaleString('ar-EG') %></span>
                          </div>
                          <p><%= comment.content %></p>
                        </div>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <p class="community-empty-comments">مفيش تعليقات لحد دلوقتي.</p>
                  <% } %>

                  <% if (user && user.role === 'user') { %>
                    <form action="/community/posts/<%= post.id %>/comments" method="POST" class="community-comment-form">
                      <textarea name="content" rows="3" placeholder="اكتب تعليقك هنا..."></textarea>
                      <button type="submit" class="btn btn-primary btn-sm">إرسال التعليق</button>
                    </form>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section id="jobs" class="community-section">
        <div class="section-header">
          <h2>التوظيف داخل Codentra</h2>
          <span class="community-meta-badge"><%= jobs.length %> وظيفة مفتوحة</span>
        </div>

        <% if (user && user.role === 'user' && myApplications && myApplications.length) { %>
          <div class="community-tracking-panel community-card">
            <div class="section-header">
              <div>
                <h3>متابعة طلباتك</h3>
                <p>تابع حالة كل طلب من لحظة الاستلام وحتى القبول أو التوظيف النهائي.</p>
              </div>
              <span class="community-meta-badge"><%= myApplications.length %> طلب</span>
            </div>

            <div class="community-tracking-grid">
              <% myApplications.forEach(application => { %>
                <article class="community-tracking-card">
                  <div class="community-tracking-head">
                    <div>
                      <h4><%= application.jobTitle %></h4>
                      <p>آخر تحديث: <%= new Date(application.statusUpdatedAt || application.createdAt).toLocaleString('ar-EG') %></p>
                    </div>
                    <span class="status-badge <%= application.statusMeta.badgeClass %>"><%= application.statusMeta.label %></span>
                  </div>

                  <p class="community-tracking-description"><%= application.trackingNote || application.statusMeta.description %></p>

                  <% if (application.aiScreeningView && application.aiScreeningView.summary) { %>
                    <div class="community-ai-review">
                      <div class="community-ai-review-head">
                        <span class="status-badge <%= application.aiScreeningView.meta.badgeClass %>"><%= application.aiScreeningView.meta.label %></span>
                        <% if (application.aiScreeningView.score) { %>
                          <span class="community-meta-badge">التوافق: <%= application.aiScreeningView.score %>%</span>
                        <% } %>
                      </div>
                      <p><%= application.aiScreeningView.summary || application.aiScreeningView.meta.description %></p>
                      <% if (application.aiScreeningView.reasons && application.aiScreeningView.reasons.length) { %>
                        <ul class="community-ai-reasons">
                          <% application.aiScreeningView.reasons.forEach(reason => { %>
                            <li><%= reason %></li>
                          <% }) %>
                        </ul>
                      <% } %>
                    </div>
                  <% } %>

                  <div class="community-progress-steps">
                    <% application.progressSteps.forEach(step => { %>
                      <span class="community-progress-step <%= step.isCurrent ? 'current' : '' %> <%= step.isDone ? 'done' : '' %>">
                        <%= step.shortLabel %>
                      </span>
                    <% }) %>
                    <% if (application.status === 'rejected') { %>
                      <span class="community-progress-step rejected current">رفض</span>
                    <% } %>
                  </div>

                  <details class="community-status-history">
                    <summary>سجل المتابعة</summary>
                    <div class="community-status-history-list">
                      <% application.statusHistory.slice().reverse().forEach(entry => { const entryMeta = {
                        pending: { label: 'تم الاستلام', badgeClass: 'pending' },
                        reviewing: { label: 'قيد المراجعة', badgeClass: 'review' },
                        shortlisted: { label: 'تم ترشيحك', badgeClass: 'shortlisted' },
                        interview: { label: 'مرحلة المقابلة', badgeClass: 'interview' },
                        accepted: { label: 'قبول مبدئي', badgeClass: 'approved' },
                        hired: { label: 'تم التوظيف', badgeClass: 'hired' },
                        rejected: { label: 'تم الرفض', badgeClass: 'rejected' }
                      }[entry.status] || { label: entry.status, badgeClass: 'pending' }; %>
                        <div class="community-history-item">
                          <div class="community-history-head">
                            <span class="status-badge <%= entryMeta.badgeClass %>"><%= entryMeta.label %></span>
                            <span><%= new Date(entry.updatedAt).toLocaleString('ar-EG') %></span>
                          </div>
                          <% if (entry.note) { %>
                            <p><%= entry.note %></p>
                          <% } %>
                          <small>
                            <%= entry.actorType === 'admin' ? 'تحديث من الإدارة' : (entry.actorType === 'applicant' ? 'تم إنشاؤه مع التقديم' : 'تحديث تلقائي') %>
                            <% if (entry.updatedByName) { %>- <%= entry.updatedByName %><% } %>
                          </small>
                        </div>
                      <% }) %>
                    </div>
                  </details>
                </article>
              <% }) %>
            </div>
          </div>
        <% } %>

        <% if (!jobs || jobs.length === 0) { %>
          <div class="empty-state">
            <p>لا توجد وظائف مفتوحة الآن. تابعنا هنا أول بأول.</p>
          </div>
        <% } else { %>
          <div class="community-jobs-grid">
            <% jobs.forEach(job => { %>
              <article class="community-card community-job-card">
                <div class="community-job-head">
                  <div>
                    <h3><%= job.title %></h3>
                    <p>نُشرت بواسطة <%= job.createdByName || 'Codentra' %> - <%= new Date(job.createdAt).toLocaleDateString('ar-EG') %></p>
                  </div>
                  <% if (job.applicationStatus) { %>
                    <span class="status-badge <%= job.applicationStatus.statusMeta.badgeClass %>"><%= job.applicationStatus.statusMeta.label %></span>
                  <% } else { %>
                    <span class="community-meta-badge">مفتوحة</span>
                  <% } %>
                </div>

                <div class="community-job-pills">
                  <span>الأجر: <%= job.salary %></span>
                  <span>الخبرة: <%= job.yearsLabel %></span>
                  <span>المتقدمون: <%= job.applicationCount %></span>
                </div>

                <p class="community-job-description"><%= job.description %></p>

                <% if (user && user.role === 'user') { %>
                  <% if (job.hasApplied) { %>
                    <div class="success-message community-inline-message">
                      تم إرسال طلبك على هذه الوظيفة.
                      <% if (job.applicationStatus && job.applicationStatus.statusMeta) { %>
                        حالته الآن: <strong><%= job.applicationStatus.statusMeta.label %></strong>
                      <% } %>
                    </div>
                    <% if (job.applicationStatus && job.applicationStatus.aiScreeningView && job.applicationStatus.aiScreeningView.summary) { %>
                      <div class="community-ai-review compact">
                        <div class="community-ai-review-head">
                          <span class="status-badge <%= job.applicationStatus.aiScreeningView.meta.badgeClass %>"><%= job.applicationStatus.aiScreeningView.meta.label %></span>
                          <% if (job.applicationStatus.aiScreeningView.score) { %>
                            <span class="community-meta-badge">التوافق: <%= job.applicationStatus.aiScreeningView.score %>%</span>
                          <% } %>
                        </div>
                        <p><%= job.applicationStatus.aiScreeningView.summary || job.applicationStatus.aiScreeningView.meta.description %></p>
                      </div>
                    <% } %>
                    <% if (job.applicationStatus && job.applicationStatus.trackingNote) { %>
                      <p class="community-tracking-description"><%= job.applicationStatus.trackingNote %></p>
                    <% } %>
                  <% } else { %>
                    <form action="/community/jobs/<%= job.id %>/apply" method="POST" enctype="multipart/form-data" class="community-apply-form">
                      <div class="form-row">
                        <div class="form-group">
                          <label>الاسم</label>
                          <input type="text" name="name" value="<%= user.name %>" required>
                        </div>
                        <div class="form-group">
                          <label>العمر</label>
                          <input type="number" name="age" min="1" required>
                        </div>
                      </div>
                      <div class="form-group">
                        <label>عرفنا بنفسك</label>
                        <textarea name="about" rows="4" placeholder="اكتب نبذة مختصرة عن خبرتك وشخصيتك ولماذا مناسب للوظيفة" required></textarea>
                      </div>
                      <div class="form-group">
                        <label>السيرة الذاتية</label>
                        <input type="file" name="cv" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required>
                      </div>
                      <button type="submit" class="btn btn-primary">إرسال التقديم</button>
                    </form>
                  <% } %>
                <% } else if (!user) { %>
                  <div class="community-job-cta">
                    <p>سجل دخول بحسابك للتقديم على الوظيفة.</p>
                    <a href="/login" class="btn btn-secondary">تسجيل الدخول</a>
                  </div>
                <% } else { %>
                  <div class="community-job-cta">
                    <p>التقديم متاح للحسابات العادية، بينما الإدارة تدير النشر والمتابعة.</p>
                    <% if (user.isSuperAdmin) { %>
                      <a href="/admin/community/jobs" class="btn btn-secondary">إدارة الوظائف</a>
                    <% } %>
                  </div>
                <% } %>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/community.js"></script>
</body>
</html>
