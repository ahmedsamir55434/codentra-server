# Database
DATABASE_URL=postgresql://user:password@localhost:5432/codentra

# Session
SESSION_SECRET=your-secret-key-here

# JWT
JWT_SECRET=your-jwt-secret-here

# Email Configuration (OPTION 1: Resend API - RECOMMENDED)
# Resend is more reliable than SMTP. Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Email Configuration (OPTION 2: SMTP - Alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@gmail.com

# Currency Exchange
FALLBACK_EGP_TO_USD_RATE=0.02

# API Keys
GEMINI_API_KEY=your-gemini-api-key
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Payment
ATLOS_API_KEY=your-atlos-key
ATLOS_API_SECRET=your-atlos-secret

# Environment
NODE_ENV=development
PORT=3000
